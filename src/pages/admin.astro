---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import fs from 'fs';
import path from 'path';

export const prerender = false;

// 1. Fetch current data on the server to render lists
let professors: any[] = [];
let rooms: any[] = [];
let subjects: any[] = [];
let batches: any[] = [];
let fetchError = null;

// Load settings from settings.json
let settings = {
  activeDays: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
  totalSlots: 4,
  breakSlot: "Slot 4"
};

try {
  const settingsPath = path.join(process.cwd(), 'settings.json');
  if (fs.existsSync(settingsPath)) {
    settings = JSON.parse(fs.readFileSync(settingsPath, 'utf8'));
  }
} catch (e: any) {
  console.error("Failed to load settings in admin frontmatter:", e);
}

try {
  const [profRes, roomRes, subjRes, batchRes] = await Promise.all([
    supabase.from('professors').select('*').order('id', { ascending: true }),
    supabase.from('rooms').select('*').order('id', { ascending: true }),
    supabase.from('subjects').select('*').order('id', { ascending: true }),
    supabase.from('batches').select('*').order('id', { ascending: true })
  ]);

  if (profRes.error) throw profRes.error;
  if (roomRes.error) throw roomRes.error;
  if (subjRes.error) throw subjRes.error;
  if (batchRes.error) throw batchRes.error;

  professors = profRes.data || [];
  rooms = roomRes.data || [];
  subjects = subjRes.data || [];
  batches = batchRes.data || [];
} catch (e: any) {
  console.error("Failed to load database lists for admin:", e);
  fetchError = e.message || e;
}

// Fetch database counts and load conflicts details for diagnostic system logs
let conflictsCount = 0;
try {
  const conflictsPath = path.join(process.cwd(), 'conflicts.json');
  if (fs.existsSync(conflictsPath)) {
    const data = JSON.parse(fs.readFileSync(conflictsPath, 'utf8'));
    conflictsCount = data.conflictsCount || 0;
  }
} catch (e) {
  console.error("Failed to load conflicts in admin frontmatter:", e);
}

let scheduledSlotsCount = 0;
try {
  const { count, error } = await supabase.from('master_timetable').select('*', { count: 'exact', head: true });
  if (!error) {
    scheduledSlotsCount = count || 0;
  }
} catch (e) {
  console.error("Failed to load timetable count in admin frontmatter:", e);
}
---

<Layout title="Administration Portal - SchedulerPro">
  <main class="admin-container">
    <!-- Top Decorative Glow Mesh -->
    <div class="mesh-glow"></div>

    <!-- Header Area -->
    <header class="admin-header glass-panel" style="padding: 24px; border-radius: 20px; margin-bottom: 32px;">
      <div class="header-content">
        <span class="eyebrow-accent">System administration</span>
        <h1>Administration portal</h1>
        <p class="description">Configure scheduling parameters, manage academic entities, and run the constraint satisfaction solver.</p>
      </div>
      <div class="header-actions">
        <a href="/dashboard" class="dashboard-link-btn glass-panel" style="border-radius: 8px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
          Go to dashboard
        </a>
      </div>
    </header>

    {fetchError && (
      <div class="error-banner">
        <h3>Database error</h3>
        <p>Could not load administration lists. Verify Supabase connection settings.</p>
        <code class="error-code">{fetchError}</code>
      </div>
    )}

    <!-- Navigation Tabs -->
    <nav class="admin-tabs" id="admin-tabs-nav">
      <button class="tab-btn active" data-tab="scheduler">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
        Scheduler & config
      </button>
      <button class="tab-btn" data-tab="setup">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        Auto-scheduling setup
      </button>
      <button class="tab-btn" data-tab="professors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        Faculty ({professors.length})
      </button>
      <button class="tab-btn" data-tab="rooms">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="21" x2="9" y2="9"></line><line x1="3" y1="9" x2="21" y2="9"></line></svg>
        Classrooms ({rooms.length})
      </button>
      <button class="tab-btn" data-tab="subjects">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
        Subjects ({subjects.length})
      </button>
      <button class="tab-btn" data-tab="batches">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        Batches ({batches.length})
      </button>
    </nav>

    <!-- Global Action Notification Toast -->
    <div id="toast-notif" class="toast hidden"></div>

    <!-- Panel Content Area -->
    <div class="panels-container">
      
      <!-- Scheduler & Config Panel -->
      <section id="panel-scheduler" class="tab-panel active">
        <div class="panel-layout grid-2">
          
          <!-- Configuration Card -->
          <div class="admin-card glass-panel">
            <h2>Timetable settings</h2>
            <p class="card-desc">Configure parameters used by the AI solver and dashboard timetable grid.</p>
            
            <form id="form-settings" class="settings-form">
              <!-- Active Days Checkboxes -->
              <div class="form-group">
                <label>Active days of the week</label>
                <div class="checkbox-grid">
                  {['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'].map(day => (
                    <label class="checkbox-label">
                      <input 
                        type="checkbox" 
                        name="activeDays" 
                        value={day} 
                        checked={settings.activeDays.includes(day)}
                      />
                      <span>{day}</span>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Total Slots -->
              <div class="form-group">
                <label for="input-total-slots">Total slots per day</label>
                <div class="counter-input">
                  <button type="button" id="btn-slots-dec" class="counter-btn">-</button>
                  <input 
                    type="number" 
                    id="input-total-slots" 
                    name="totalSlots" 
                    min="1" 
                    max="10" 
                    value={settings.totalSlots} 
                    readonly
                  />
                  <button type="button" id="btn-slots-inc" class="counter-btn">+</button>
                </div>
                <small class="form-help">Number of academic hours/periods per day (max 10).</small>
              </div>

              <!-- Designate Break Slot -->
              <div class="form-group">
                <label for="select-break-slot">Designated break slot</label>
                <select id="select-break-slot" name="breakSlot" style="background-color: var(--color-border);">
                  <option value="none">No break designated</option>
                  {Array.from({ length: settings.totalSlots }, (_, i) => `Slot ${i + 1}`).map(slot => (
                    <option value={slot} selected={settings.breakSlot === slot}>{slot}</option>
                  ))}
                </select>
                <small class="form-help">This slot will be grayed out on the dashboard. The solver will skip scheduling lessons in it.</small>
              </div>

              <button type="submit" class="primary-submit-btn" style="background-color: var(--color-primary); border-color: var(--color-primary); color: #fff;">Save configurations</button>
            </form>
          </div>

          <!-- Execution Card -->
          <div class="admin-card execution-card glass-panel-emphasis">
            <h2>AI scheduler execution</h2>
            <p class="card-desc">Execute Google OR-Tools constraint satisfaction solver. This clears previous schedule records and creates a new clash-free layout.</p>
            
            <div class="scheduler-action-box" style="background: rgba(110, 155, 132, 0.05); border: 1px solid rgba(110, 155, 132, 0.15); display: flex; flex-direction: column; gap: 20px;">
              <!-- Left side: Button and solver state -->
              <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 16px;">
                <button id="btn-run-scheduler" class="run-solver-btn" style="background: var(--color-primary); box-shadow: 0 4px 14px rgba(110, 155, 132, 0.3); border: none; color: #ffffff; padding: 14px 28px; border-radius: 30px; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 8px;">
                  <div class="spinner hidden" id="scheduler-spinner"></div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="scheduler-icon"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  <span>Run AI scheduler</span>
                </button>
                
                <div class="solver-status" id="solver-status-message" style="margin-top: 16px; font-size: 13px; font-weight: 500;">
                  Ready to schedule lessons.
                </div>
              </div>

              <!-- Divider line -->
              <div class="diagnostic-divider" style="border-top: 1px solid rgba(110, 155, 132, 0.15);"></div>

              <!-- Right side: System Diagnostics -->
              <div style="flex: 1; display: flex; flex-direction: column; gap: 12px; padding: 16px; font-size: 13px;">
                <h4 style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); margin-bottom: 4px;">System Diagnostics</h4>
                
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="color: var(--color-text-secondary); font-medium">Database connection</span>
                  <span style="display: flex; align-items: center; gap: 6px; font-weight: 600; color: #10b981;">
                    <span id="db-connection-dot" class="pulse-dot" style="width: 6px; height: 6px; border-radius: 50%; background-color: #10b981;"></span>
                    <span id="db-connection-status">Connected to Supabase</span>
                  </span>
                </div>
                
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="color: var(--color-text-secondary);">Scheduled slots</span>
                  <span style="font-weight: 700; color: var(--color-text-primary);" id="diagnostic-slots-count">{scheduledSlotsCount}</span>
                </div>
                
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="color: var(--color-text-secondary);">Active requirements</span>
                  <span style="font-weight: 700; color: var(--color-text-primary);" id="diagnostic-req-count">...</span>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="color: var(--color-text-secondary);">Conflicts detected</span>
                  <span style="font-weight: 700;" id="diagnostic-conflicts-status" data-count={conflictsCount}>...</span>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 8px; border-top: 1px solid rgba(255, 255, 255, 0.06);">
                  <span style="color: var(--color-text-secondary);">Last executed</span>
                  <span style="font-weight: 600; color: var(--color-text-muted);" id="diagnostic-last-run">Not yet run</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Auto-Scheduling Setup Panel -->
      <section id="panel-setup" class="tab-panel">
        <div class="panel-layout grid-2">
          
          <!-- Setup input form card -->
          <div class="admin-card glass-panel-emphasis">
            <h2>Add scheduling requirement</h2>
            <p class="card-desc">Define teaching rules per faculty member. The AI solver will respect these assignments.</p>
            
            <form id="form-add-requirement" class="entity-form">
              <!-- Select Professor -->
              <div class="form-group">
                <label for="setup-prof-select">Faculty member</label>
                <select id="setup-prof-select" required style="background-color: var(--color-border);">
                  <option value="" disabled selected>Select professor</option>
                  {professors.map(p => (
                    <option value={p.id}>{p.full_name} ({p.department})</option>
                  ))}
                </select>
              </div>

              <!-- Select Subject -->
              <div class="form-group">
                <label for="setup-subject-select">Subject course</label>
                <select id="setup-subject-select" required style="background-color: var(--color-border);">
                  <option value="" disabled selected>Select subject</option>
                  {subjects.map(s => (
                    <option value={s.id} data-room-type={s.required_room_type}>{s.subject_name} (Requires {s.required_room_type})</option>
                  ))}
                </select>
              </div>

              <!-- Select Batch -->
              <div class="form-group">
                <label for="setup-batch-select">Student batch</label>
                <select id="setup-batch-select" required style="background-color: var(--color-border);">
                  <option value="" disabled selected>Select student batch</option>
                  {batches.map(b => (
                    <option value={b.id}>{b.batch_name} ({b.student_count} students)</option>
                  ))}
                </select>
              </div>

              <!-- Lectures/Week -->
              <div class="form-group">
                <label for="setup-lectures-input">Required lectures per week</label>
                <input type="number" id="setup-lectures-input" min="1" max="10" value="3" required style="background-color: var(--color-border);" />
              </div>

              <!-- Eligible Classrooms -->
              <div class="form-group">
                <label>Eligible classrooms & labs</label>
                <div class="checkbox-grid" style="max-height: 180px; overflow-y: auto; background-color: var(--color-border);" id="setup-rooms-checkboxes">
                  {rooms.map(r => (
                    <label class="checkbox-label" data-room-type={r.room_type}>
                      <input type="checkbox" name="eligibleRooms" value={r.id} checked />
                      <span class="text-xs">{r.room_number} ({r.room_type})</span>
                    </label>
                  ))}
                </div>
                <small class="form-help">Optionally filter or override rooms. By default, matches subject requirements.</small>
              </div>

              <button type="submit" class="primary-submit-btn" style="background-color: var(--color-primary); color: #fff; border-color: var(--color-primary);">
                Add assignment rule
              </button>
            </form>
          </div>

          <!-- Requirements list card -->
          <div class="admin-card glass-panel">
            <h2>Active assignment requirements</h2>
            <p class="card-desc">Current rules loaded in the auto-scheduling engine.</p>
            
            <div class="list-wrapper">
              <table class="entity-table">
                <thead>
                  <tr>
                    <th>Faculty & subject details</th>
                    <th>Batch</th>
                    <th>Hours</th>
                    <th>Rooms</th>
                    <th class="actions-header">Actions</th>
                  </tr>
                </thead>
                <tbody id="requirements-table-body">
                  <tr>
                    <td colspan="5" class="empty-list">Loading requirements...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </section>

      <!-- Faculty Management Panel -->
      <section id="panel-professors" class="tab-panel">
        <div class="panel-layout grid-2">
          <!-- Add form -->
          <div class="admin-card glass-panel">
            <h2>Add faculty member</h2>
            <p class="card-desc">Create a new professor record in the database database.</p>
            <form id="form-add-professor" class="entity-form">
              <div class="form-group">
                <label for="prof-name">Full name</label>
                <input type="text" id="prof-name" name="full_name" required placeholder="e.g. Dr. Jane Foster" style="background-color: var(--color-border);" />
              </div>
              <div class="form-group">
                <label for="prof-email">Email address</label>
                <input type="email" id="prof-email" name="email" required placeholder="e.g. jfoster@university.edu" style="background-color: var(--color-border);" />
              </div>
              <div class="form-group">
                <label for="prof-dept">Department</label>
                <input type="text" id="prof-dept" name="department" required placeholder="e.g. Computer Science & AI" style="background-color: var(--color-border);" />
              </div>
              <div class="form-group">
                <label for="prof-hours">Maximum weekly hours</label>
                <input type="number" id="prof-hours" name="max_weekly_hours" min="1" max="40" value="18" required style="background-color: var(--color-border);" />
              </div>
              <button type="submit" class="primary-submit-btn" style="background-color: var(--color-primary); border-color: var(--color-primary); color: #fff;">Add professor</button>
            </form>
          </div>

          <!-- List and Delete -->
          <div class="admin-card glass-panel">
            <h2>Active faculty directory</h2>
            <p class="card-desc">List of professors available for timetable scheduling.</p>
            <div class="list-wrapper">
              <table class="entity-table">
                <thead>
                  <tr>
                    <th>Professor name</th>
                    <th>Department</th>
                    <th>Max hours</th>
                    <th class="actions-header">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {professors.map(p => (
                    <tr class="entity-row">
                      <td>
                        <div class="name-cell">
                          <strong>{p.full_name}</strong>
                          <span>{p.email}</span>
                        </div>
                      </td>
                      <td>{p.department}</td>
                      <td>{p.max_weekly_hours}h / wk</td>
                      <td class="action-cell">
                        <button class="delete-entity-btn" data-type="professors" data-id={p.id} data-name={p.full_name}>
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                      </td>
                    </tr>
                  ))}
                  {professors.length === 0 && (
                    <tr>
                      <td colspan="4" class="empty-list">No faculty members found in database.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Rooms Panel -->
      <section id="panel-rooms" class="tab-panel">
        <div class="panel-layout grid-2">
          <!-- Add form -->
          <div class="admin-card glass-panel">
            <h2>Add classroom / lab</h2>
            <p class="card-desc">Register a new campus room or laboratory room.</p>
            <form id="form-add-room" class="entity-form">
              <div class="form-group">
                <label for="room-number">Room number / name</label>
                <input type="text" id="room-number" name="room_number" required placeholder="e.g. CR-302, Lab-104" style="background-color: var(--color-border);" />
              </div>
              <div class="form-group">
                <label for="room-type">Room type</label>
                <select id="room-type" name="room_type" required style="background-color: var(--color-border);">
                  <option value="Lecture Hall">Lecture Hall</option>
                  <option value="AI/ML Lab">AI/ML Lab</option>
                  <option value="Standard Classroom">Standard Classroom</option>
                  <option value="Seminar Room">Seminar Room</option>
                </select>
              </div>
              <div class="form-group">
                <label for="room-cap">Student capacity</label>
                <input type="number" id="room-cap" name="capacity" min="5" max="200" value="60" required style="background-color: var(--color-border);" />
              </div>
              <button type="submit" class="primary-submit-btn" style="background-color: var(--color-primary); border-color: var(--color-primary); color: #fff;">Add classroom</button>
            </form>
          </div>

          <!-- List and Delete -->
          <div class="admin-card glass-panel">
            <h2>Classroom inventory</h2>
            <p class="card-desc">Rooms currently available for allocation.</p>
            <div class="list-wrapper">
              <table class="entity-table">
                <thead>
                  <tr>
                    <th>Room number</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th class="actions-header">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {rooms.map(r => (
                    <tr class="entity-row">
                      <td><strong>{r.room_number}</strong></td>
                      <td>
                        <span class={`room-type-pill ${r.room_type.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`}>
                          {r.room_type}
                        </span>
                      </td>
                      <td>{r.capacity} seats</td>
                      <td class="action-cell">
                        <button class="delete-entity-btn" data-type="rooms" data-id={r.id} data-name={r.room_number}>
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                      </td>
                    </tr>
                  ))}
                  {rooms.length === 0 && (
                    <tr>
                      <td colspan="4" class="empty-list">No classrooms found in database.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Subjects Panel -->
      <section id="panel-subjects" class="tab-panel">
        <div class="panel-layout grid-2">
          <!-- Add form -->
          <div class="admin-card glass-panel">
            <h2>Add subject course</h2>
            <p class="card-desc">Create a new course curriculum subject entry.</p>
            <form id="form-add-subject" class="entity-form">
              <div class="form-group">
                <label for="subj-name">Subject title</label>
                <input type="text" id="subj-name" name="subject_name" required placeholder="e.g. Advanced Operating Systems" style="background-color: var(--color-border);" />
              </div>
              <div class="form-group">
                <label for="subj-room-type">Required classroom type</label>
                <select id="subj-room-type" name="required_room_type" required style="background-color: var(--color-border);">
                  <option value="Lecture Hall">Lecture Hall</option>
                  <option value="AI/ML Lab">AI/ML Lab</option>
                  <option value="Standard Classroom">Standard Classroom</option>
                  <option value="Seminar Room">Seminar Room</option>
                </select>
              </div>
              <button type="submit" class="primary-submit-btn" style="background-color: var(--color-primary); border-color: var(--color-primary); color: #fff;">Add subject</button>
            </form>
          </div>

          <!-- List and Delete -->
          <div class="admin-card glass-panel">
            <h2>Curriculum subjects</h2>
            <p class="card-desc">Subjects requiring weekly course scheduling.</p>
            <div class="list-wrapper">
              <table class="entity-table">
                <thead>
                  <tr>
                    <th>Subject title</th>
                    <th>Required space</th>
                    <th class="actions-header">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {subjects.map(s => (
                    <tr class="entity-row">
                      <td><strong>{s.subject_name}</strong></td>
                      <td>
                        <span class={`room-type-pill ${s.required_room_type.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`}>
                          {s.required_room_type}
                        </span>
                      </td>
                      <td class="action-cell">
                        <button class="delete-entity-btn" data-type="subjects" data-id={s.id} data-name={s.subject_name}>
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                      </td>
                    </tr>
                  ))}
                  {subjects.length === 0 && (
                    <tr>
                      <td colspan="3" class="empty-list">No subjects found in database.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Batches Panel -->
      <section id="panel-batches" class="tab-panel">
        <div class="panel-layout grid-2">
          <!-- Add form -->
          <div class="admin-card glass-panel">
            <h2>Add student batch</h2>
            <p class="card-desc">Create a new academic student cohort batch.</p>
            <form id="form-add-batch" class="entity-form">
              <div class="form-group">
                <label for="batch-name">Batch name</label>
                <input type="text" id="batch-name" name="batch_name" required placeholder="e.g. BCA 3rd Year" style="background-color: var(--color-border);" />
              </div>
              <div class="form-group">
                <label for="batch-count">Total student intake</label>
                <input type="number" id="batch-count" name="student_count" min="5" max="150" value="50" required style="background-color: var(--color-border);" />
              </div>
              <button type="submit" class="primary-submit-btn" style="background-color: var(--color-primary); border-color: var(--color-primary); color: #fff;">Add batch</button>
            </form>
          </div>

          <!-- List and Delete -->
          <div class="admin-card glass-panel">
            <h2>Active student cohorts</h2>
            <p class="card-desc">Groups attending courses scheduled by the solver.</p>
            <div class="list-wrapper">
              <table class="entity-table">
                <thead>
                  <tr>
                    <th>Batch name</th>
                    <th>Cohort size</th>
                    <th class="actions-header">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {batches.map(b => (
                    <tr class="entity-row">
                      <td><strong>{b.batch_name}</strong></td>
                      <td>{b.student_count} students</td>
                      <td class="action-cell">
                        <button class="delete-entity-btn" data-type="batches" data-id={b.id} data-name={b.batch_name}>
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                      </td>
                    </tr>
                  ))}
                  {batches.length === 0 && (
                    <tr>
                      <td colspan="3" class="empty-list">No student batches found in database.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<!-- Embed Master Data for Client-Side Setup Logic -->
<script type="application/json" id="professors-data-raw" is:inline set:html={JSON.stringify(professors)}></script>
<script type="application/json" id="subjects-data-raw" is:inline set:html={JSON.stringify(subjects)}></script>
<script type="application/json" id="batches-data-raw" is:inline set:html={JSON.stringify(batches)}></script>
<script type="application/json" id="rooms-data-raw" is:inline set:html={JSON.stringify(rooms)}></script>

<!-- Client Side Logic -->
<script>
    // Parse master lists for requirements form
    const professorsData = JSON.parse(document.getElementById('professors-data-raw')?.textContent || '[]');
    const subjectsData = JSON.parse(document.getElementById('subjects-data-raw')?.textContent || '[]');
    const batchesData = JSON.parse(document.getElementById('batches-data-raw')?.textContent || '[]');
    const roomsData = JSON.parse(document.getElementById('rooms-data-raw')?.textContent || '[]');
    
    let activeRequirements = [];

    // 1. TABS SYSTEM
    const tabs = document.querySelectorAll('#admin-tabs-nav .tab-btn');
    const panels = document.querySelectorAll('.panels-container .tab-panel');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetTab = tab.getAttribute('data-tab');
        
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        
        tab.classList.add('active');
        const activePanel = document.getElementById(`panel-${targetTab}`);
        if (activePanel) activePanel.classList.add('active');
      });
    });

    // 2. TOAST SYSTEM
    const toast = document.getElementById('toast-notif');
    function showToast(message, isError = false) {
      if (!toast) return;
      toast.textContent = message;
      toast.className = `toast ${isError ? 'error' : 'success'}`;
      toast.style.display = 'block';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 5000);
    }

    // 3. AUTO-SCHEDULING REQUIREMENTS SETUP SYSTEM
    const selectSubject = document.getElementById('setup-subject-select') as HTMLSelectElement;
    selectSubject?.addEventListener('change', () => {
      const selectedOpt = selectSubject.options[selectSubject.selectedIndex];
      const reqRoomType = selectedOpt.getAttribute('data-room-type');
      
      const checkboxes = document.querySelectorAll('#setup-rooms-checkboxes input[type="checkbox"]');
      checkboxes.forEach(cb => {
        const label = cb.closest('label');
        if (label) {
          const roomType = label.getAttribute('data-room-type');
          if (roomType === reqRoomType) {
            (cb as HTMLInputElement).checked = true;
          } else {
            (cb as HTMLInputElement).checked = false;
          }
        }
      });
    });

    async function loadRequirements() {
      try {
        const res = await fetch('/api/requirements');
        const result = await res.json();
        if (result.success) {
          activeRequirements = result.requirements || [];
          renderRequirementsTable();
          
          // Update diagnostics requirement count
          const reqCountEl = document.getElementById('diagnostic-req-count');
          if (reqCountEl) {
            reqCountEl.textContent = activeRequirements.length;
          }
        }
      } catch (err) {
        console.error('Failed to load scheduling requirements:', err);
      }
    }

    function renderRequirementsTable() {
      const tbody = document.getElementById('requirements-table-body');
      if (!tbody) return;
      
      if (activeRequirements.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="empty-list">No scheduling requirements defined yet.</td></tr>`;
        return;
      }

      tbody.innerHTML = '';
      activeRequirements.forEach((req) => {
        const prof = professorsData.find(p => p.id === req.professorId);
        const subj = subjectsData.find(s => s.id === req.subjectId);
        const batch = batchesData.find(b => b.id === req.batchId);
        
        const roomNumbers = (req.eligibleRoomIds || [])
          .map(rid => {
            const r = roomsData.find(room => room.id === rid);
            return r ? r.room_number : null;
          })
          .filter(Boolean)
          .join(', ');

        const tr = document.createElement('tr');
        tr.className = 'entity-row';
        tr.innerHTML = `
          <td>
            <div class="name-cell">
              <strong>${prof ? prof.full_name : 'Unknown'}</strong>
              <span class="text-xs text-slate-500">${subj ? subj.subject_name : 'Unknown'}</span>
            </div>
          </td>
          <td>${batch ? batch.batch_name : 'Unknown'}</td>
          <td>${req.lecturesPerWeek} / week</td>
          <td><span class="text-xs text-slate-500">${roomNumbers || 'Any room'}</span></td>
          <td class="action-cell">
            <button class="delete-req-btn delete-entity-btn" data-id="${req.id}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      // Add delete listeners
      tbody.querySelectorAll('.delete-req-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const reqId = btn.getAttribute('data-id');
          if (!confirm('Are you sure you want to delete this requirement?')) return;
          
          activeRequirements = activeRequirements.filter(r => r.id !== reqId);
          
          try {
            const res = await fetch('/api/requirements', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ requirements: activeRequirements })
            });
            const result = await res.json();
            if (result.success) {
              showToast('Scheduling requirement deleted successfully.');
              renderRequirementsTable();
            } else {
              showToast(result.error || 'Failed to update requirements.', true);
            }
          } catch (err) {
            showToast('Error deleting requirement.', true);
          }
        });
      });
    }

    const formAddRequirement = document.getElementById('form-add-requirement');
    formAddRequirement?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const profId = parseInt((document.getElementById('setup-prof-select') as HTMLSelectElement).value);
      const subjId = parseInt((document.getElementById('setup-subject-select') as HTMLSelectElement).value);
      const batchId = parseInt((document.getElementById('setup-batch-select') as HTMLSelectElement).value);
      const lectures = parseInt((document.getElementById('setup-lectures-input') as HTMLInputElement).value);
      
      const checkboxes = document.querySelectorAll('#setup-rooms-checkboxes input[type="checkbox"]:checked');
      const eligibleRoomIds = Array.from(checkboxes).map(cb => parseInt((cb as HTMLInputElement).value));

      if (isNaN(profId) || isNaN(subjId) || isNaN(batchId) || isNaN(lectures)) {
        showToast('Please select all required fields.', true);
        return;
      }

      const newReq = {
        id: `req_${Date.now()}`,
        professorId: profId,
        subjectId: subjId,
        batchId: batchId,
        lecturesPerWeek: lectures,
        eligibleRoomIds: eligibleRoomIds
      };

      activeRequirements.push(newReq);
      
      try {
        const res = await fetch('/api/requirements', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ requirements: activeRequirements })
        });
        const result = await res.json();
        if (result.success) {
          showToast('Scheduling requirement added successfully!');
          renderRequirementsTable();
          // Reset form inputs except checkboxes
          (document.getElementById('setup-prof-select') as HTMLSelectElement).value = '';
          (document.getElementById('setup-subject-select') as HTMLSelectElement).value = '';
          (document.getElementById('setup-batch-select') as HTMLSelectElement).value = '';
          (document.getElementById('setup-lectures-input') as HTMLInputElement).value = '3';
          document.querySelectorAll('#setup-rooms-checkboxes input[type="checkbox"]').forEach(cb => {
            (cb as HTMLInputElement).checked = true;
          });
        } else {
          showToast(result.error || 'Failed to save requirement.', true);
        }
      } catch (err) {
        showToast('Error saving requirement.', true);
      }
    });

    loadRequirements();
    checkDatabaseHealth();

    async function checkDatabaseHealth() {
      const dbStatusEl = document.getElementById('db-connection-status');
      const dbDotEl = document.getElementById('db-connection-dot');
      if (!dbStatusEl || !dbDotEl) return;

      try {
        const res = await fetch('/api/requirements');
        const result = await res.json();
        if (result.success) {
          dbStatusEl.textContent = 'Connected to Supabase';
          if (dbStatusEl.parentElement) {
            dbStatusEl.parentElement.style.color = '#10b981';
          }
          dbDotEl.style.backgroundColor = '#10b981';
        } else {
          throw new Error('API failed');
        }
      } catch (err) {
        dbStatusEl.textContent = 'Disconnected';
        if (dbStatusEl.parentElement) {
          dbStatusEl.parentElement.style.color = '#ef4444';
        }
        dbDotEl.style.backgroundColor = '#ef4444';
      }
    }

    // Diagnostics System Logs Client Logic
    function updateLastRunTime() {
      const lastRun = localStorage.getItem('scheduler_last_run');
      const lastRunEl = document.getElementById('diagnostic-last-run');
      if (!lastRunEl) return;
      if (!lastRun) {
        lastRunEl.textContent = 'Not yet run in this session';
        return;
      }
      
      const diffMs = Date.now() - parseInt(lastRun, 10);
      const diffMins = Math.floor(diffMs / 60000);
      if (diffMins < 1) {
        lastRunEl.textContent = 'Just now';
      } else if (diffMins === 1) {
        lastRunEl.textContent = '1 minute ago';
      } else {
        lastRunEl.textContent = `${diffMins} minutes ago`;
      }
    }
    
    // Update conflict diagnostic label
    const conflictsCount = parseInt(document.getElementById('diagnostic-conflicts-status')?.getAttribute('data-count') || '0', 10);
    const conflictsStatusEl = document.getElementById('diagnostic-conflicts-status');
    if (conflictsStatusEl) {
      if (conflictsCount > 0) {
        conflictsStatusEl.textContent = `${conflictsCount} active conflicts`;
        conflictsStatusEl.style.color = '#ef4444'; // Red
      } else {
        conflictsStatusEl.textContent = 'No conflicts detected';
        conflictsStatusEl.style.color = '#10b981'; // Emerald
      }
    }
    
    updateLastRunTime();
    setInterval(updateLastRunTime, 30000);

    // 4. SETTINGS SYSTEM (Total Slots +/- counter)
    const btnDec = document.getElementById('btn-slots-dec');
    const btnInc = document.getElementById('btn-slots-inc');
    const inputSlots = document.getElementById('input-total-slots') as HTMLInputElement;
    const selectBreak = document.getElementById('select-break-slot') as HTMLSelectElement;

    function updateBreakSlotOptions(totalSlots) {
      const currentValue = selectBreak.value;
      selectBreak.innerHTML = '';
      
      const noneOpt = document.createElement('option');
      noneOpt.value = 'none';
      noneOpt.textContent = 'No break designated';
      selectBreak.appendChild(noneOpt);

      for (let i = 1; i <= totalSlots; i++) {
        const optName = `Slot ${i}`;
        const opt = document.createElement('option');
        opt.value = optName;
        opt.textContent = optName;
        if (currentValue === optName) {
          opt.selected = true;
        }
        selectBreak.appendChild(opt);
      }
    }

    btnDec?.addEventListener('click', () => {
      if (!inputSlots) return;
      const current = parseInt(inputSlots.value);
      if (current > 1) {
        inputSlots.value = (current - 1).toString();
        updateBreakSlotOptions(current - 1);
      }
    });

    btnInc?.addEventListener('click', () => {
      if (!inputSlots) return;
      const current = parseInt(inputSlots.value);
      if (current < 10) {
        inputSlots.value = (current + 1).toString();
        updateBreakSlotOptions(current + 1);
      }
    });

    // Handle Settings Submission
    const formSettings = document.getElementById('form-settings') as HTMLFormElement;
    formSettings?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(formSettings);
      const activeDays = formData.getAll('activeDays');
      const totalSlots = inputSlots ? parseInt(inputSlots.value) : 4;
      const breakSlotVal = selectBreak.value;
      const breakSlot = breakSlotVal === 'none' ? null : breakSlotVal;

      try {
        const res = await fetch('/api/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ activeDays, totalSlots, breakSlot })
        });
        const result = await res.json();
        if (result.success) {
          showToast('Scheduler settings saved successfully!');
        } else {
          showToast(result.error || 'Failed to save settings.', true);
        }
      } catch (err: any) {
        showToast('Unexpected network error saving settings.', true);
      }
    });

    // 5. ENTITY FORMS (ADD ENTITIES)
    const entityForms = [
      { id: 'form-add-professor', url: '/api/professors' },
      { id: 'form-add-room', url: '/api/rooms' },
      { id: 'form-add-subject', url: '/api/subjects' },
      { id: 'form-add-batch', url: '/api/batches' }
    ];

    entityForms.forEach(({ id, url }) => {
      const form = document.getElementById(id) as HTMLFormElement;
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const data: any = {};
        formData.forEach((value, key) => {
          data[key] = value;
        });

        try {
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await res.json();
          if (result.success) {
            showToast('Entry successfully added to database!');
            setTimeout(() => window.location.reload(), 800);
          } else {
            showToast(result.error || 'Failed to insert entry.', true);
          }
        } catch (err) {
          showToast('Unexpected network error inserting record.', true);
        }
      });
    });

    // 6. DELETE ENTITIES
    const deleteButtons = document.querySelectorAll('.delete-entity-btn');
    deleteButtons.forEach(btn => {
      // Don't bind delete buttons inside the setup table since they are bound dynamically
      if (btn.classList.contains('delete-req-btn')) return;

      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const type = btn.getAttribute('data-type');
        const name = btn.getAttribute('data-name');
        
        if (!confirm(`Are you sure you want to delete "${name}" from ${type}?`)) {
          return;
        }

        try {
          const res = await fetch(`/api/${type}?id=${id}`, {
            method: 'DELETE'
          });
          const result = await res.json();
          if (result.success) {
            showToast(`"${name}" was deleted successfully.`);
            setTimeout(() => window.location.reload(), 800);
          } else {
            showToast(result.error || `Failed to delete entry.`, true);
          }
        } catch (err) {
          showToast('Unexpected network error deleting record.', true);
        }
      });
    });

    // 7. SCHEDULER RUN LOGIC
    const btnRun = document.getElementById('btn-run-scheduler');
    const spinner = document.getElementById('scheduler-spinner');
    const icon = document.getElementById('scheduler-icon');
    const statusMsg = document.getElementById('solver-status-message');
    const btnText = btnRun?.querySelector('span');

    btnRun?.addEventListener('click', async () => {
      btnRun.setAttribute('disabled', 'true');
      spinner?.classList.remove('hidden');
      icon?.classList.add('hidden');
      if (btnText) btnText.textContent = 'Generating schedule...';
      if (statusMsg) {
        statusMsg.textContent = 'AI solver running constraint programming model... please wait.';
        statusMsg.className = 'solver-status running';
      }

      try {
        const res = await fetch('/api/generate', { method: 'POST' });
        const result = await res.json();
        
        if (result.success) {
          showToast('Timetable schedule generated successfully!');
          localStorage.setItem('scheduler_last_run', Date.now().toString());
          updateLastRunTime();
          if (statusMsg) {
            statusMsg.textContent = '✅ Optimal schedule generated successfully!';
            statusMsg.className = 'solver-status success';
          }
          if (btnText) btnText.textContent = 'Schedule generated!';
          spinner?.classList.add('hidden');
          
          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 2000);
        } else {
          showToast(result.error || 'Failed to generate timetable.', true);
          if (statusMsg) {
            statusMsg.textContent = 'Failure: solver failed to find a valid layout.';
            statusMsg.className = 'solver-status error';
          }
          btnRun.removeAttribute('disabled');
          spinner?.classList.add('hidden');
          icon?.classList.remove('hidden');
          if (btnText) btnText.textContent = 'Run AI scheduler';
        }
      } catch (err: any) {
        showToast('Unexpected error launching scheduler API.', true);
        if (statusMsg) {
          statusMsg.textContent = 'Network execution failure.';
          statusMsg.className = 'solver-status error';
        }
        btnRun.removeAttribute('disabled');
        spinner?.classList.add('hidden');
        icon?.classList.remove('hidden');
        if (btnText) btnText.textContent = 'Run AI scheduler';
      }
    });
</script>

<style>
  .admin-container {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }

  .mesh-glow {
    position: absolute;
    top: -100px;
    left: 20%;
    right: 20%;
    height: 350px;
    background: radial-gradient(circle, rgba(110, 155, 132, 0.08) 0%, rgba(142, 140, 199, 0.04) 50%, rgba(0,0,0,0) 70%);
    filter: blur(80px);
    z-index: -1;
    pointer-events: none;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }

  h1 {
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 8px 0;
    color: var(--color-text-primary);
  }

  .description {
    font-size: 16px;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 650px;
    line-height: 1.5;
  }

  .dashboard-link-btn {
    text-decoration: none;
    color: var(--color-text-primary);
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .dashboard-link-btn:hover {
    background-color: rgba(255, 255, 255, 0.4);
    border-color: var(--color-border-hover);
  }

  /* Admin Tabs Navigation */
  .admin-tabs {
    display: flex;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 32px;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 1px;
  }

  .tab-btn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--color-text-secondary);
    padding: 12px 20px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .tab-btn:hover {
    color: var(--color-text-primary);
    border-bottom-color: var(--color-border-hover);
  }

  .tab-btn.active {
    color: var(--color-primary-dark);
    border-bottom-color: var(--color-primary);
    font-weight: 600;
  }

  /* Panels layout */
  .tab-panel {
    display: none;
