---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import fs from 'fs';
import path from 'path';

export const prerender = false;

// 1. Fetch current data on the server to render lists
let professors: any[] = [];
let rooms: any[] = [];
let subjects: any[] = [];
let batches: any[] = [];
let fetchError = null;

// Load settings from settings.json
let settings = {
  activeDays: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
  totalSlots: 4,
  breakSlot: "Slot 4"
};

try {
  const settingsPath = path.join(process.cwd(), 'settings.json');
  if (fs.existsSync(settingsPath)) {
    settings = JSON.parse(fs.readFileSync(settingsPath, 'utf8'));
  }
} catch (e: any) {
  console.error("Failed to load settings in admin frontmatter:", e);
}

try {
  const [profRes, roomRes, subjRes, batchRes] = await Promise.all([
    supabase.from('professors').select('*').order('id', { ascending: true }),
    supabase.from('rooms').select('*').order('id', { ascending: true }),
    supabase.from('subjects').select('*').order('id', { ascending: true }),
    supabase.from('batches').select('*').order('id', { ascending: true })
  ]);

  if (profRes.error) throw profRes.error;
  if (roomRes.error) throw roomRes.error;
  if (subjRes.error) throw subjRes.error;
  if (batchRes.error) throw batchRes.error;

  professors = profRes.data || [];
  rooms = roomRes.data || [];
  subjects = subjRes.data || [];
  batches = batchRes.data || [];
} catch (e: any) {
  console.error("Failed to load database lists for admin:", e);
  fetchError = e.message || e;
}
---

<Layout title="Admin Portal - SchedulerPro">
  <main class="admin-container">
    <!-- Top Decorative Glow Mesh -->
    <div class="mesh-glow"></div>

    <!-- Header Area -->
    <header class="admin-header">
      <div class="header-content">
        <span class="eyebrow-accent">System Administration</span>
        <h1>Administration Portal.</h1>
        <p class="description">Configure scheduling parameters, manage academic entities, and run the constraint satisfaction solver.</p>
      </div>
      <div class="header-actions">
        <a href="/dashboard" class="dashboard-link-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
          Go to Dashboard
        </a>
      </div>
    </header>

    {fetchError && (
      <div class="error-banner">
        <h3>Database Error</h3>
        <p>Could not load administration lists. Verify Supabase connection settings.</p>
        <code class="error-code">{fetchError}</code>
      </div>
    )}

    <!-- Navigation Tabs -->
    <nav class="admin-tabs" id="admin-tabs-nav">
      <button class="tab-btn active" data-tab="scheduler">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
        Scheduler & Config
      </button>
      <button class="tab-btn" data-tab="professors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        Faculty ({professors.length})
      </button>
      <button class="tab-btn" data-tab="rooms">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="21" x2="9" y2="9"></line><line x1="3" y1="9" x2="21" y2="9"></line></svg>
        Classrooms ({rooms.length})
      </button>
      <button class="tab-btn" data-tab="subjects">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
        Subjects ({subjects.length})
      </button>
      <button class="tab-btn" data-tab="batches">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        Batches ({batches.length})
      </button>
    </nav>

    <!-- Global Action Notification Toast -->
    <div id="toast-notif" class="toast hidden"></div>

    <!-- Panel Content Area -->
    <div class="panels-container">
      
      <!-- Scheduler & Config Panel -->
      <section id="panel-scheduler" class="tab-panel active">
        <div class="panel-layout grid-2">
          
          <!-- Configuration Card -->
          <div class="admin-card">
            <h2>Timetable Settings</h2>
            <p class="card-desc">Configure parameters used by the AI Solver and Dashboard timetable grid.</p>
            
            <form id="form-settings" class="settings-form">
              <!-- Active Days Checkboxes -->
              <div class="form-group">
                <label>Active Days of the Week</label>
                <div class="checkbox-grid">
                  {['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'].map(day => (
                    <label class="checkbox-label">
                      <input 
                        type="checkbox" 
                        name="activeDays" 
                        value={day} 
                        checked={settings.activeDays.includes(day)}
                      />
                      <span>{day}</span>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Total Slots -->
              <div class="form-group">
                <label for="input-total-slots">Total Slots Per Day</label>
                <div class="counter-input">
                  <button type="button" id="btn-slots-dec" class="counter-btn">-</button>
                  <input 
                    type="number" 
                    id="input-total-slots" 
                    name="totalSlots" 
                    min="1" 
                    max="10" 
                    value={settings.totalSlots} 
                    readonly
                  />
                  <button type="button" id="btn-slots-inc" class="counter-btn">+</button>
                </div>
                <small class="form-help">Number of academic hours/periods per day (Max 10).</small>
              </div>

              <!-- Designate Break Slot -->
              <div class="form-group">
                <label for="select-break-slot">Designated Break Slot</label>
                <select id="select-break-slot" name="breakSlot">
                  <option value="none">No Break designated</option>
                  {Array.from({ length: settings.totalSlots }, (_, i) => `Slot ${i + 1}`).map(slot => (
                    <option value={slot} selected={settings.breakSlot === slot}>{slot}</option>
                  ))}
                </select>
                <small class="form-help">This slot will be grayed out on the dashboard. The solver will skip scheduling lessons in it.</small>
              </div>

              <button type="submit" class="primary-submit-btn">Save Configurations</button>
            </form>
          </div>

          <!-- Execution Card -->
          <div class="admin-card execution-card">
            <h2>AI Scheduler Execution</h2>
            <p class="card-desc">Execute Google OR-Tools constraint satisfaction solver. This clears previous schedule records and creates a new clash-free layout.</p>
            
            <div class="scheduler-action-box">
              <button id="btn-run-scheduler" class="run-solver-btn">
                <div class="spinner hidden" id="scheduler-spinner"></div>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="scheduler-icon"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                <span>Run AI Scheduler</span>
              </button>
              
              <div class="solver-status" id="solver-status-message">
                Ready to schedule lessons.
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Faculty Management Panel -->
      <section id="panel-professors" class="tab-panel">
        <div class="panel-layout grid-2">
          <!-- Add form -->
          <div class="admin-card">
            <h2>Add Faculty Member</h2>
            <p class="card-desc">Create a new professor record in the database database.</p>
            <form id="form-add-professor" class="entity-form">
              <div class="form-group">
                <label for="prof-name">Full Name</label>
                <input type="text" id="prof-name" name="full_name" required placeholder="e.g. Dr. Jane Foster" />
              </div>
              <div class="form-group">
                <label for="prof-email">Email Address</label>
                <input type="email" id="prof-email" name="email" required placeholder="e.g. jfoster@university.edu" />
              </div>
              <div class="form-group">
                <label for="prof-dept">Department</label>
                <input type="text" id="prof-dept" name="department" required placeholder="e.g. Computer Science & AI" />
              </div>
              <div class="form-group">
                <label for="prof-hours">Maximum Weekly Hours</label>
                <input type="number" id="prof-hours" name="max_weekly_hours" min="1" max="40" value="18" required />
              </div>
              <button type="submit" class="primary-submit-btn">Add Professor</button>
            </form>
          </div>

          <!-- List and Delete -->
          <div class="admin-card">
            <h2>Active Faculty Directory</h2>
            <p class="card-desc">List of professors available for timetable scheduling.</p>
            <div class="list-wrapper">
              <table class="entity-table">
                <thead>
                  <tr>
                    <th>Professor Name</th>
                    <th>Department</th>
                    <th>Max Hours</th>
                    <th class="actions-header">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {professors.map(p => (
                    <tr class="entity-row">
                      <td>
                        <div class="name-cell">
                          <strong>{p.full_name}</strong>
                          <span>{p.email}</span>
                        </div>
                      </td>
                      <td>{p.department}</td>
                      <td>{p.max_weekly_hours}h / wk</td>
                      <td class="action-cell">
                        <button class="delete-entity-btn" data-type="professors" data-id={p.id} data-name={p.full_name}>
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                      </td>
                    </tr>
                  ))}
                  {professors.length === 0 && (
                    <tr>
                      <td colspan="4" class="empty-list">No faculty members found in database.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Rooms Panel -->
      <section id="panel-rooms" class="tab-panel">
        <div class="panel-layout grid-2">
          <!-- Add form -->
          <div class="admin-card">
            <h2>Add Classroom / Lab</h2>
            <p class="card-desc">Register a new campus room or laboratory room.</p>
            <form id="form-add-room" class="entity-form">
              <div class="form-group">
                <label for="room-number">Room Number / Name</label>
                <input type="text" id="room-number" name="room_number" required placeholder="e.g. CR-302, Lab-104" />
              </div>
              <div class="form-group">
                <label for="room-type">Room Type</label>
                <select id="room-type" name="room_type" required>
                  <option value="Lecture Hall">Lecture Hall</option>
                  <option value="AI/ML Lab">AI/ML Lab</option>
                  <option value="Standard Classroom">Standard Classroom</option>
                  <option value="Seminar Room">Seminar Room</option>
                </select>
              </div>
              <div class="form-group">
                <label for="room-cap">Student Capacity</label>
                <input type="number" id="room-cap" name="capacity" min="5" max="200" value="60" required />
              </div>
              <button type="submit" class="primary-submit-btn">Add Classroom</button>
            </form>
          </div>

          <!-- List and Delete -->
          <div class="admin-card">
            <h2>Classroom Inventory</h2>
            <p class="card-desc">Rooms currently available for allocation.</p>
            <div class="list-wrapper">
              <table class="entity-table">
                <thead>
                  <tr>
                    <th>Room Number</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th class="actions-header">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {rooms.map(r => (
                    <tr class="entity-row">
                      <td><strong>{r.room_number}</strong></td>
                      <td>
                        <span class={`room-type-pill ${r.room_type.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`}>
                          {r.room_type}
                        </span>
                      </td>
                      <td>{r.capacity} seats</td>
                      <td class="action-cell">
                        <button class="delete-entity-btn" data-type="rooms" data-id={r.id} data-name={r.room_number}>
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                      </td>
                    </tr>
                  ))}
                  {rooms.length === 0 && (
                    <tr>
                      <td colspan="4" class="empty-list">No classrooms found in database.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Subjects Panel -->
      <section id="panel-subjects" class="tab-panel">
        <div class="panel-layout grid-2">
          <!-- Add form -->
          <div class="admin-card">
            <h2>Add Subject Course</h2>
            <p class="card-desc">Create a new course curriculum subject entry.</p>
            <form id="form-add-subject" class="entity-form">
              <div class="form-group">
                <label for="subj-name">Subject Title</label>
                <input type="text" id="subj-name" name="subject_name" required placeholder="e.g. Advanced Operating Systems" />
              </div>
              <div class="form-group">
                <label for="subj-room-type">Required Classroom Type</label>
                <select id="subj-room-type" name="required_room_type" required>
                  <option value="Lecture Hall">Lecture Hall</option>
                  <option value="AI/ML Lab">AI/ML Lab</option>
                  <option value="Standard Classroom">Standard Classroom</option>
                  <option value="Seminar Room">Seminar Room</option>
                </select>
              </div>
              <button type="submit" class="primary-submit-btn">Add Subject</button>
            </form>
          </div>

          <!-- List and Delete -->
          <div class="admin-card">
            <h2>Curriculum Subjects</h2>
            <p class="card-desc">Subjects requiring weekly course scheduling.</p>
            <div class="list-wrapper">
              <table class="entity-table">
                <thead>
                  <tr>
                    <th>Subject Title</th>
                    <th>Required Space</th>
                    <th class="actions-header">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {subjects.map(s => (
                    <tr class="entity-row">
                      <td><strong>{s.subject_name}</strong></td>
                      <td>
                        <span class={`room-type-pill ${s.required_room_type.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`}>
                          {s.required_room_type}
                        </span>
                      </td>
                      <td class="action-cell">
                        <button class="delete-entity-btn" data-type="subjects" data-id={s.id} data-name={s.subject_name}>
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                      </td>
                    </tr>
                  ))}
                  {subjects.length === 0 && (
                    <tr>
                      <td colspan="3" class="empty-list">No subjects found in database.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Batches Panel -->
      <section id="panel-batches" class="tab-panel">
        <div class="panel-layout grid-2">
          <!-- Add form -->
          <div class="admin-card">
            <h2>Add Student Batch</h2>
            <p class="card-desc">Create a new academic student cohort batch.</p>
            <form id="form-add-batch" class="entity-form">
              <div class="form-group">
                <label for="batch-name">Batch Name</label>
                <input type="text" id="batch-name" name="batch_name" required placeholder="e.g. BCA 3rd Year" />
              </div>
              <div class="form-group">
                <label for="batch-count">Total Student Intake</label>
                <input type="number" id="batch-count" name="student_count" min="5" max="150" value="50" required />
              </div>
              <button type="submit" class="primary-submit-btn">Add Batch</button>
            </form>
          </div>

          <!-- List and Delete -->
          <div class="admin-card">
            <h2>Active Student Cohorts</h2>
            <p class="card-desc">Groups attending courses scheduled by the solver.</p>
            <div class="list-wrapper">
              <table class="entity-table">
                <thead>
                  <tr>
                    <th>Batch Name</th>
                    <th>Cohort Size</th>
                    <th class="actions-header">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {batches.map(b => (
                    <tr class="entity-row">
                      <td><strong>{b.batch_name}</strong></td>
                      <td>{b.student_count} students</td>
                      <td class="action-cell">
                        <button class="delete-entity-btn" data-type="batches" data-id={b.id} data-name={b.batch_name}>
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                      </td>
                    </tr>
                  ))}
                  {batches.length === 0 && (
                    <tr>
                      <td colspan="3" class="empty-list">No student batches found in database.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<!-- Client Side Logic -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    // 1. TABS SYSTEM
    const tabs = document.querySelectorAll('#admin-tabs-nav .tab-btn');
    const panels = document.querySelectorAll('.panels-container .tab-panel');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetTab = tab.getAttribute('data-tab');
        
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        
        tab.classList.add('active');
        const activePanel = document.getElementById(`panel-${targetTab}`);
        if (activePanel) activePanel.classList.add('active');
      });
    });

    // 2. TOAST SYSTEM
    const toast = document.getElementById('toast-notif');
    function showToast(message, isError = false) {
      if (!toast) return;
      toast.textContent = message;
      toast.className = `toast ${isError ? 'error' : 'success'}`;
      toast.style.display = 'block';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 5000);
    }

    // 3. SETTINGS SYSTEM (Total Slots +/- counter)
    const btnDec = document.getElementById('btn-slots-dec');
    const btnInc = document.getElementById('btn-slots-inc');
    const inputSlots = document.getElementById('input-total-slots') as HTMLInputElement;
    const selectBreak = document.getElementById('select-break-slot') as HTMLSelectElement;

    function updateBreakSlotOptions(totalSlots) {
      const currentValue = selectBreak.value;
      selectBreak.innerHTML = '';
      
      const noneOpt = document.createElement('option');
      noneOpt.value = 'none';
      noneOpt.textContent = 'No Break designated';
      selectBreak.appendChild(noneOpt);

      for (let i = 1; i <= totalSlots; i++) {
        const optName = `Slot ${i}`;
        const opt = document.createElement('option');
        opt.value = optName;
        opt.textContent = optName;
        if (currentValue === optName) {
          opt.selected = true;
        }
        selectBreak.appendChild(opt);
      }
    }

    btnDec?.addEventListener('click', () => {
      if (!inputSlots) return;
      const current = parseInt(inputSlots.value);
      if (current > 1) {
        inputSlots.value = (current - 1).toString();
        updateBreakSlotOptions(current - 1);
      }
    });

    btnInc?.addEventListener('click', () => {
      if (!inputSlots) return;
      const current = parseInt(inputSlots.value);
      if (current < 10) {
        inputSlots.value = (current + 1).toString();
        updateBreakSlotOptions(current + 1);
      }
    });

    // Handle Settings Submission
    const formSettings = document.getElementById('form-settings') as HTMLFormElement;
    formSettings?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(formSettings);
      const activeDays = formData.getAll('activeDays');
      const totalSlots = inputSlots ? parseInt(inputSlots.value) : 4;
      const breakSlotVal = selectBreak.value;
      const breakSlot = breakSlotVal === 'none' ? null : breakSlotVal;

      try {
        const res = await fetch('/api/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ activeDays, totalSlots, breakSlot })
        });
        const result = await res.json();
        if (result.success) {
          showToast('Scheduler settings saved successfully!');
        } else {
          showToast(result.error || 'Failed to save settings.', true);
        }
      } catch (err: any) {
        showToast('Unexpected network error saving settings.', true);
      }
    });

    // 4. ENTITY FORMS (ADD ENTITIES)
    const entityForms = [
      { id: 'form-add-professor', url: '/api/professors' },
      { id: 'form-add-room', url: '/api/rooms' },
      { id: 'form-add-subject', url: '/api/subjects' },
      { id: 'form-add-batch', url: '/api/batches' }
    ];

    entityForms.forEach(({ id, url }) => {
      const form = document.getElementById(id) as HTMLFormElement;
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const data: any = {};
        formData.forEach((value, key) => {
          data[key] = value;
        });

        try {
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await res.json();
          if (result.success) {
            showToast('Entry successfully added to database!');
            setTimeout(() => window.location.reload(), 800);
          } else {
            showToast(result.error || 'Failed to insert entry.', true);
          }
        } catch (err) {
          showToast('Unexpected network error inserting record.', true);
        }
      });
    });

    // 5. DELETE ENTITIES
    const deleteButtons = document.querySelectorAll('.delete-entity-btn');
    deleteButtons.forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const type = btn.getAttribute('data-type');
        const name = btn.getAttribute('data-name');
        
        if (!confirm(`Are you sure you want to delete "${name}" from ${type}?`)) {
          return;
        }

        try {
          const res = await fetch(`/api/${type}?id=${id}`, {
            method: 'DELETE'
          });
          const result = await res.json();
          if (result.success) {
            showToast(`"${name}" was deleted successfully.`);
            setTimeout(() => window.location.reload(), 800);
          } else {
            showToast(result.error || `Failed to delete entry.`, true);
          }
        } catch (err) {
          showToast('Unexpected network error deleting record.', true);
        }
      });
    });

    // 6. SCHEDULER RUN LOGIC
    const btnRun = document.getElementById('btn-run-scheduler');
    const spinner = document.getElementById('scheduler-spinner');
    const icon = document.getElementById('scheduler-icon');
    const statusMsg = document.getElementById('solver-status-message');
    const btnText = btnRun?.querySelector('span');

    btnRun?.addEventListener('click', async () => {
      // Disable UI during generation
      btnRun.setAttribute('disabled', 'true');
      spinner?.classList.remove('hidden');
      icon?.classList.add('hidden');
      if (btnText) btnText.textContent = 'Generating Schedule...';
      if (statusMsg) {
        statusMsg.textContent = 'AI Solver running constraint programming model... please wait.';
        statusMsg.className = 'solver-status running';
      }

      try {
        const res = await fetch('/api/generate', { method: 'POST' });
        const result = await res.json();
        
        if (result.success) {
          showToast('Timetable schedule generated successfully!');
          if (statusMsg) {
            statusMsg.textContent = '✅ Optimal Schedule Generated Successfully!';
            statusMsg.className = 'solver-status success';
          }
          if (btnText) btnText.textContent = 'Schedule Generated!';
          spinner?.classList.add('hidden');
          
          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 2000);
        } else {
          showToast(result.error || 'Failed to generate timetable.', true);
          if (statusMsg) {
            statusMsg.textContent = 'Failure: Solver failed to find a valid layout.';
            statusMsg.className = 'solver-status error';
          }
          // Restore button state
          btnRun.removeAttribute('disabled');
          spinner?.classList.add('hidden');
          icon?.classList.remove('hidden');
          if (btnText) btnText.textContent = 'Run AI Scheduler';
        }
      } catch (err: any) {
        showToast('Unexpected error launching scheduler API.', true);
        if (statusMsg) {
          statusMsg.textContent = 'Network execution failure.';
          statusMsg.className = 'solver-status error';
        }
        // Restore button state
        btnRun.removeAttribute('disabled');
        spinner?.classList.add('hidden');
        icon?.classList.remove('hidden');
        if (btnText) btnText.textContent = 'Run AI Scheduler';
      }
    });

  });
</script>

