---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import fs from 'fs';
import path from 'path';

export const prerender = false;

// 1. Load settings from settings.json
let settings = {
  activeDays: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
  totalSlots: 4,
  breakSlot: 'Slot 4'
};

try {
  const settingsPath = path.join(process.cwd(), 'settings.json');
  if (fs.existsSync(settingsPath)) {
    settings = JSON.parse(fs.readFileSync(settingsPath, 'utf8'));
  }
} catch (e: any) {
  console.error("Failed to load settings in dashboard frontmatter:", e);
}

const days = settings.activeDays;
const timeSlots = Array.from({ length: settings.totalSlots }, (_, i) => `Slot ${i + 1}`);
const breakSlot = settings.breakSlot;

// 2. Fetch data from the master_timetable table with joined tables
let timetableData: any[] = [];
let fetchError = null;

try {
  const { data, error } = await supabase
    .from('master_timetable')
    .select(`
      id,
      day_of_week,
      time_slot,
      room_id,
      professor_id,
      subject_id,
      batch_id,
      professors ( id, full_name, email, department, max_weekly_hours ),
      rooms ( id, room_number, room_type, capacity ),
      subjects ( id, subject_name, required_room_type ),
      batches ( id, batch_name, student_count )
    `);
    
  if (error) {
    throw error;
  }
  timetableData = data || [];
} catch (e: any) {
  console.error("Failed to load timetable data:", e);
  fetchError = e.message || e;
}

// 3. Fetch master entity lists for editing dropdowns
let allProfessors: any[] = [];
let allRooms: any[] = [];
let allSubjects: any[] = [];
let allBatches: any[] = [];

try {
  const [profRes, roomRes, subjRes, batchRes] = await Promise.all([
    supabase.from('professors').select('*').order('full_name', { ascending: true }),
    supabase.from('rooms').select('*').order('room_number', { ascending: true }),
    supabase.from('subjects').select('*').order('subject_name', { ascending: true }),
    supabase.from('batches').select('*').order('batch_name', { ascending: true })
  ]);
  allProfessors = profRes.data || [];
  allRooms = roomRes.data || [];
  allSubjects = subjRes.data || [];
  allBatches = batchRes.data || [];
} catch (e: any) {
  console.error("Failed to load database lists for dashboard editing:", e);
}

// 4. Extract unique lists for client-side filtering dropdowns
const filterBatches = [...new Set(timetableData.map(item => item.batches?.batch_name).filter(Boolean))];
const filterProfessors = [...new Set(timetableData.map(item => item.professors?.full_name).filter(Boolean))];
const filterRooms = [...new Set(timetableData.map(item => item.rooms?.room_number).filter(Boolean))];

// 5. Helper function to get timetable cell items
function getGridClassesForCell(day: string, slot: string) {
  return timetableData.filter(item => item.day_of_week === day && item.time_slot === slot);
}

// 6. Pill coloring based on student batch name (Soft light pastels & muted neons in dark mode)
function getBatchColorClass(batchName: string) {
  const name = (batchName || '').toLowerCase();
  if (name.includes('1st') || name.includes('1')) {
    return 'bg-blue-100 text-blue-700 border border-blue-200/50 dark:bg-blue-500/10 dark:text-blue-400 dark:border-blue-500/20';
  }
  if (name.includes('2nd') || name.includes('2')) {
    return 'bg-purple-100 text-purple-700 border border-purple-200/50 dark:bg-purple-500/10 dark:text-purple-400 dark:border-purple-500/20';
  }
  if (name.includes('3rd') || name.includes('3')) {
    return 'bg-emerald-100 text-emerald-700 border border-emerald-200/50 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20';
  }
  return 'bg-indigo-100 text-indigo-700 border border-indigo-200/50 dark:bg-indigo-500/10 dark:text-indigo-400 dark:border-indigo-500/20';
}

// Helper to determine the soft background and border colors for grid cells based on batch
function getBatchBgClass(batchName: string) {
  const name = (batchName || '').toLowerCase();
  if (name.includes('1st') || name.includes('1')) {
    return 'bg-blue-50/60 border-blue-200/50 dark:bg-blue-950/20 dark:border-blue-900/30';
  }
  if (name.includes('2nd') || name.includes('2')) {
    return 'bg-purple-50/60 border-purple-200/50 dark:bg-purple-950/20 dark:border-purple-900/30';
  }
  if (name.includes('3rd') || name.includes('3')) {
    return 'bg-emerald-50/60 border-emerald-200/50 dark:bg-emerald-950/20 dark:border-emerald-900/30';
  }
  return 'bg-indigo-50/60 border-indigo-200/50 dark:bg-indigo-950/20 dark:border-indigo-900/30';
}

// Helper to determine the left strip accent indicator color for cards
function getBatchStripClass(batchName: string) {
  const name = (batchName || '').toLowerCase();
  if (name.includes('1st') || name.includes('1')) {
    return 'bg-blue-500';
  }
  if (name.includes('2nd') || name.includes('2')) {
    return 'bg-purple-500';
  }
  if (name.includes('3rd') || name.includes('3')) {
    return 'bg-emerald-500';
  }
  return 'bg-indigo-500';
}
