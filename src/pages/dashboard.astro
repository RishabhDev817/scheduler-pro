    position: absolute;
    top: -100px;
    left: 20%;
    right: 20%;
    height: 350px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.08) 0%, rgba(59, 130, 246, 0.04) 50%, rgba(0,0,0,0) 70%);
    filter: blur(80px);
    z-index: -1;
    pointer-events: none;
  }

  /* Sub Header Styling */
