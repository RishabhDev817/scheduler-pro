                              data-id={item.id}
                              data-batch={item.batches?.batch_name}
                              data-batch-count={item.batches?.student_count}
                              data-room={item.rooms?.room_number}
                              data-room-capacity={item.rooms?.capacity}
                              data-room-type={item.rooms?.room_type}
                              data-subject={item.subjects?.subject_name}
                              data-prof={item.professors?.full_name}
                              data-prof-email={item.professors?.email}
                              data-prof-dept={item.professors?.department}
                              data-day={item.day_of_week}
                              data-slot={item.time_slot}
                            >
                              <div class="flex justify-between items-center mb-1.5">
                                <span class={`badge ${getBatchColorClass(item.batches?.batch_name)}`}>
                                  {item.batches?.batch_name}
