                                          {item.batches?.batch_name}
                                        </span>
                                        <span class="badge room-badge bg-[rgba(214,162,76,0.18)] dark:bg-[rgba(214,162,76,0.22)] text-[#7A5A1E] dark:text-[#F3D39B] border border-[rgba(214,162,76,0.3)] dark:border-[rgba(214,162,76,0.4)] text-[10px] px-2 py-0.5 rounded-md font-semibold">
