        <!-- 3. Room Utilization Analysis Panel -->
        <section id="room-utilization-panel" class="view-panel glass-panel p-5 md:p-6 shadow-sm">
          <h2 class="text-base font-bold text-slate-900 dark:text-zinc-100 mb-1">Classroom & lab utilization analysis</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">Real-time room occupancy rates and session loads derived from active schedules.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {allRooms.map(room => {
              const activeCount = timetableData.filter(t => t.room_id === room.id).length;
              const maxAvailable = days.length * (timeSlots.length - 1); // exclude break slot
              const usagePercent = Math.min(100, Math.round((activeCount / maxAvailable) * 100)) || 0;
              
              let progressColor = 'bg-primary';
              if (usagePercent > 80) progressColor = 'bg-red-500';
              else if (usagePercent > 60) progressColor = 'bg-amber-500';
              else if (usagePercent > 0) progressColor = 'bg-emerald-500';

              return (
                <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-750 rounded-lg p-4 flex flex-col justify-between">
                  <div class="flex justify-between items-start mb-3">
                    <div>
                      <h3 class="font-bold text-sm text-slate-800 dark:text-zinc-200">{room.room_number}</h3>
                      <span class="text-xs text-slate-600 dark:text-zinc-400">{room.room_type} (Cap: {room.capacity})</span>
                    </div>
                    <span class="text-xs font-semibold bg-canvas border border-slate-200 dark:border-slate-700 px-2 py-0.5 rounded text-slate-800 dark:text-zinc-200">
                      {activeCount} / {maxAvailable} slots
                    </span>
                  </div>
                  <div>
                    <div class="flex justify-between items-center text-xs mb-1">
                      <span class="font-medium text-slate-605">Usage Rate</span>
                      <span class="font-bold text-slate-900 dark:text-zinc-100">{usagePercent}%</span>
                    </div>
                    <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2">
                      <div class={`h-2 rounded-full ${progressColor}`} style={`width: ${usagePercent}%`}></div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>

        <!-- 4. Faculty Workload Analysis Panel -->
        <section id="faculty-workload-panel" class="view-panel bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 md:p-6 shadow-sm">
          <h2 class="text-base font-bold text-slate-900 dark:text-zinc-100 mb-1">Faculty workload distribution</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">Workload stats comparing active scheduled periods against weekly teaching limits.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {allProfessors.map(prof => {
              const activeSessions = timetableData.filter(t => t.professor_id === prof.id);
              const hoursScheduled = activeSessions.length * 1.5;
              const maxHours = prof.max_weekly_hours || 18;
              const workloadPercent = Math.min(100, Math.round((hoursScheduled / maxHours) * 100)) || 0;

              let progressColor = 'bg-primary';
              if (workloadPercent > 90) progressColor = 'bg-red-500';
              else if (workloadPercent > 70) progressColor = 'bg-amber-500';
              else if (workloadPercent > 0) progressColor = 'bg-emerald-500';

              return (
                <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-750 rounded-lg p-4 flex flex-col justify-between">
                  <div class="flex justify-between items-start mb-3">
                    <div>
                      <h3 class="font-bold text-sm text-slate-800 dark:text-zinc-200">{prof.full_name}</h3>
                      <span class="text-xs text-slate-600 dark:text-zinc-400">{prof.department} • {prof.email}</span>
                    </div>
                    <span class="text-xs font-semibold bg-canvas border border-slate-200 dark:border-slate-700 px-2 py-0.5 rounded text-slate-800 dark:text-zinc-200">
                      {hoursScheduled}h / {maxHours}h limit
                    </span>
                  </div>
                  <div>
                    <div class="flex justify-between items-center text-xs mb-1">
                      <span class="font-medium text-slate-600">Weekly teaching load</span>
                      <span class="font-bold text-slate-900 dark:text-zinc-100">{workloadPercent}%</span>
                    </div>
                    <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2">
                      <div class={`h-2 rounded-full ${progressColor}`} style={`width: ${workloadPercent}%`}></div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>

