          </div>
        </div>
      </div>
    </div>

    <!-- Email Modal: Email Timetable to Faculty -->
    <div id="email-faculty-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden" style="animation: fadeIn 0.2s ease-out;">
      <div class="bg-[var(--glass)] backdrop-blur-[20px] border border-[var(--glass-border)] rounded-[20px] shadow-2xl max-w-md w-full overflow-hidden flex flex-col">
        <!-- Modal Header -->
        <div class="p-5 border-b border-[var(--glass-border)] flex justify-between items-center bg-[var(--color-border-hover)]">
          <h3 class="font-bold text-sm text-[var(--color-text-primary)]">Email timetables to faculty</h3>
          <button id="email-modal-close-btn" class="text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        <!-- Modal Body -->
        <div class="p-5 flex-grow space-y-4 overflow-y-auto max-h-[300px]">
          <p class="text-xs text-[var(--color-text-secondary)] mb-2">Select professors to email their personalized teaching schedule.</p>
          
          <!-- Select All Option -->
          <label class="flex items-center gap-3 p-2 rounded-lg bg-[var(--color-border-hover)] cursor-pointer select-none">
            <input type="checkbox" id="email-select-all" class="sr-only peer" />
            <div class="w-[18px] h-[18px] rounded-[5px] border border-slate-300 dark:border-slate-600 flex-shrink-0 flex items-center justify-center bg-white/40 dark:bg-slate-800/40 peer-checked:bg-[var(--color-primary)] peer-checked:border-[var(--color-primary)] transition-all text-transparent peer-checked:text-white">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24">
