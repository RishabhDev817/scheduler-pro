        <div class="p-4 border-t border-[var(--glass-border)] bg-[var(--color-border-hover)] flex justify-between items-center gap-2">
          <button id="email-modal-cancel-btn" class="px-4.5 py-2.5 bg-transparent hover:bg-slate-100 dark:hover:bg-slate-800/60 text-slate-500 hover:text-slate-800 dark:text-zinc-400 dark:hover:text-zinc-100 rounded-xl text-xs font-bold transition-colors cursor-pointer">
            Cancel
