    <!-- Slide-over Drawer: Manual Modifications History (Audit Trail) -->
    <div id="audit-drawer" class="fixed inset-y-0 right-0 z-50 w-full max-w-sm bg-[var(--color-canvas)] backdrop-blur-[20px] border-l border-[var(--color-border)] shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300">
      <div class="p-5 border-b border-[var(--color-border)] flex justify-between items-center bg-[var(--color-border-hover)]">
        <h3 class="font-bold text-sm text-[var(--color-text-primary)] flex items-center gap-1.5">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"></path></svg>
          Manual modifications history
        </h3>
        <button id="audit-close-btn" class="text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-5 flex-grow overflow-y-auto space-y-4 bg-transparent" id="audit-trail-list">
        <!-- Rendered dynamically -->
      </div>
      <div class="p-4 border-t border-[var(--color-border)] bg-[var(--color-border-hover)] flex justify-end">
        <button id="btn-clear-audit" class="w-full py-2.5 border border-red-200 dark:border-red-900/30 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/20 rounded-lg text-xs font-bold transition-colors cursor-pointer text-center block">Clear Trail Logs</button>
      </div>
    </div>

    <!-- Slide-over Drawer: CP-SAT Optimization Solver Metrics -->
    <div id="metrics-drawer" class="fixed inset-y-0 right-0 z-50 w-full max-w-sm bg-[var(--color-canvas)] backdrop-blur-[20px] border-l border-[var(--color-border)] shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300">
      <div class="p-5 border-b border-[var(--color-border)] flex justify-between items-center bg-[var(--color-border-hover)]">
        <h3 class="font-bold text-sm text-[var(--color-text-primary)] flex items-center gap-1.5">
          <svg class="w-4 h-4 text-purple-500 animate-pulse" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"></path></svg>
          AI solver CP-SAT metrics
        </h3>
        <button id="metrics-close-btn" class="text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-5 flex-grow overflow-y-auto space-y-6 text-xs">
        <div>
          <span class="text-[10px] uppercase font-mono tracking-wider text-slate-500 block mb-1">Solver Configuration</span>
          <div class="bg-slate-50 dark:bg-slate-800 p-3 rounded-lg space-y-2 border border-slate-200 dark:border-slate-700">
            <div class="flex justify-between">
              <span class="text-slate-500">Engine</span>
              <span class="font-bold text-slate-800 dark:text-zinc-200">Google OR-Tools CP-SAT</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Constraint Model</span>
              <span class="font-bold text-slate-800 dark:text-zinc-200">Boolean Math Programming</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Optimization Goal</span>
              <span class="font-bold text-slate-800 dark:text-zinc-200">Minimize gaps / Maximize utility</span>
            </div>
          </div>
        </div>

        <div>
          <span class="text-[10px] uppercase font-mono tracking-wider text-slate-500 block mb-1">Solver Insights & Status</span>
          <div class="bg-slate-50 dark:bg-slate-800 p-3 rounded-lg space-y-2 border border-slate-200 dark:border-slate-700">
            <div class="flex justify-between">
              <span class="text-slate-550">Solve Status</span>
              <span class="font-bold text-emerald-600 dark:text-emerald-450">OPTIMAL</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-550">Execution Duration</span>
              <span class="font-bold text-slate-800 dark:text-zinc-200">1.47 seconds</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-550">Iterations (Booleans)</span>
              <span class="font-bold text-slate-800 dark:text-zinc-200">15,482 branches</span>
            </div>
          </div>
        </div>

        <div>
          <span class="text-[10px] uppercase font-mono tracking-wider text-slate-500 block mb-1">Hard Constraints Checklist</span>
          <div class="bg-slate-50 dark:bg-slate-800 p-3 rounded-lg space-y-2 font-mono text-[11px] border border-slate-200 dark:border-slate-700">
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✔</span>
              <span class="text-slate-800 dark:text-zinc-200">Faculty Double-Booking (0 conflicts)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✔</span>
              <span class="text-slate-800 dark:text-zinc-200">Room Double-Booking (0 conflicts)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✔</span>
              <span class="text-slate-800 dark:text-zinc-200">Student Cohort Clashes (0 conflicts)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✔</span>
              <span class="text-slate-800 dark:text-zinc-200">Room Capacity Matches (0 conflicts)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✔</span>
              <span class="text-slate-800 dark:text-zinc-200">Break Slots Skipped (0 conflicts)</span>
