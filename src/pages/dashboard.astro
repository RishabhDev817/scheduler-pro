---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import fs from 'fs';
import path from 'path';

export const prerender = false;

// 1. Load settings from settings.json
let settings = {
  activeDays: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
  totalSlots: 4,
  breakSlot: 'Slot 4'
};

try {
  const settingsPath = path.join(process.cwd(), 'settings.json');
  if (fs.existsSync(settingsPath)) {
    settings = JSON.parse(fs.readFileSync(settingsPath, 'utf8'));
  }
} catch (e: any) {
  console.error("Failed to load settings in dashboard frontmatter:", e);
}

const days = settings.activeDays;
const timeSlots = Array.from({ length: settings.totalSlots }, (_, i) => `Slot ${i + 1}`);
const breakSlot = settings.breakSlot;

// 2. Fetch data from the master_timetable table with joined tables
let timetableData: any[] = [];
let fetchError = null;

let conflictsCount = 0;
let conflictsDetails: any[] = [];
try {
  const conflictsPath = path.join(process.cwd(), 'conflicts.json');
  if (fs.existsSync(conflictsPath)) {
    const data = JSON.parse(fs.readFileSync(conflictsPath, 'utf8'));
    conflictsCount = data.conflictsCount || 0;
    conflictsDetails = data.details || [];
  }
} catch (e) {
  console.error("Failed to load conflicts in dashboard frontmatter:", e);
}

function isLabOrAiSession(subjectName: string) {
  const name = (subjectName || '').toLowerCase();
  return name.includes('lab') || name.includes('ai') || name.includes('neural');
}


try {
  const { data, error } = await supabase
    .from('master_timetable')
    .select(`
      id,
      day_of_week,
      time_slot,
      room_id,
      professor_id,
      subject_id,
      batch_id,
      professors ( id, full_name, email, department, max_weekly_hours ),
      rooms ( id, room_number, room_type, capacity ),
      subjects ( id, subject_name, required_room_type ),
      batches ( id, batch_name, student_count )
    `);
    
  if (error) {
    throw error;
  }
  timetableData = data || [];
} catch (e: any) {
  console.error("Failed to load timetable data:", e);
  fetchError = e.message || e;
}

// 3. Fetch master entity lists for editing dropdowns
let allProfessors: any[] = [];
let allRooms: any[] = [];
let allSubjects: any[] = [];
let allBatches: any[] = [];

try {
  const [profRes, roomRes, subjRes, batchRes] = await Promise.all([
    supabase.from('professors').select('*').order('full_name', { ascending: true }),
    supabase.from('rooms').select('*').order('room_number', { ascending: true }),
    supabase.from('subjects').select('*').order('subject_name', { ascending: true }),
    supabase.from('batches').select('*').order('batch_name', { ascending: true })
  ]);
  allProfessors = profRes.data || [];
  allRooms = roomRes.data || [];
  allSubjects = subjRes.data || [];
  allBatches = batchRes.data || [];
} catch (e: any) {
  console.error("Failed to load database lists for dashboard editing:", e);
}

// 4. Extract unique lists for client-side filtering dropdowns
const filterBatches = [...new Set(allBatches.map(item => item.batch_name).filter(Boolean))];
const filterProfessors = [...new Set(allProfessors.map(item => item.full_name).filter(Boolean))];
const filterRooms = [...new Set(allRooms.map(item => item.room_number).filter(Boolean))];

// 5. Helper function to get timetable cell items
function getGridClassesForCell(day: string, slot: string) {
  return timetableData.filter(item => item.day_of_week === day && item.time_slot === slot);
}

// 6. Pill coloring based on subject (Sage green for lectures, Lavender for labs/AI)
function getBatchColorClass(subjectName: string) {
  return isLabOrAiSession(subjectName)
    ? 'bg-[rgba(142,140,199,0.18)] dark:bg-[rgba(142,140,199,0.22)] text-[#4B4880] dark:text-[#C5C3ED] border border-[rgba(142,140,199,0.3)] dark:border-[rgba(142,140,199,0.4)]'
    : 'bg-[rgba(110,155,132,0.18)] dark:bg-[rgba(110,155,132,0.22)] text-[#3F5F4F] dark:text-[#A8D4BC] border border-[rgba(110,155,132,0.3)] dark:border-[rgba(110,155,132,0.4)]';
}

// Helper to determine background color for grid cells based on subject (glass panel styled)
function getBatchBgClass(subjectName: string) {
  return 'glass-panel';
}

// Helper to determine left strip accent indicator color for cards (Sage green or Lavender)
function getBatchStripClass(subjectName: string) {
  return isLabOrAiSession(subjectName) ? 'bg-[#8E8CC7]' : 'bg-[#6E9B84]';
}

---

<Layout title="Interactive Schedule Dashboard - SchedulerPro">
  <!-- Load html2pdf from CDN dynamically -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" is:inline></script>

  <main class="max-w-7xl mx-auto px-6 py-8 font-sans space-y-8 relative">
    <!-- Top Decorative Glow Mesh -->
    <div class="mesh-glow"></div>

    <!-- Header Area: Clean full-width alignment -->
    <div class="mb-10 border-b border-slate-200/50 dark:border-slate-800/50 pb-6 w-full block">
      <div class="space-y-4">
        <div class="space-y-1">
          <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest block">ACADEMIC ADMINISTRATION</span>
          <h1 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight">Academic dashboard</h1>
        </div>
        <!-- Primary Actions Group -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- Re-run AI solver -->
          <button id="btn-dashboard-run-solver" class="bg-[#6E9B84] hover:bg-[#3F5F4F] text-white font-semibold px-4 py-2.5 rounded-xl shadow-sm transition-all duration-150 flex items-center gap-1.5 active:scale-[0.98] cursor-pointer">
            <div class="solver-spinner spinner hidden"></div>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.656 48.656 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l-3 3m3-3l3 3"></path></svg>
            <span>Re-run AI solver</span>
          </button>

          <!-- Admin Portal Link -->
          <a href="/admin" class="border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-white hover:text-slate-950 dark:hover:bg-slate-800 dark:hover:text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition-all duration-150 flex items-center gap-1.5 glass-panel cursor-pointer" title="Open Admin Portal">
            <span>Admin portal</span>
          </a>

          <!-- Actions & Export Dropdown -->
          <div class="relative inline-block text-left" id="actions-dropdown">
            <button id="btn-actions-toggle" class="border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-white hover:text-slate-950 dark:hover:bg-slate-800 dark:hover:text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition-all duration-150 flex items-center gap-1.5 cursor-pointer shadow-sm active:scale-[0.98] glass-panel">
              <span>Actions and export</span>
            </button>
            <div id="actions-dropdown-menu" class="absolute left-0 mt-2 w-48 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-lg z-50 hidden py-1.5 animate-fade-in origin-top-left">
              <button id="btn-export-ical" class="w-full text-left px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-2 font-semibold cursor-pointer">
                <span>iCal</span>
              </button>
              <button id="btn-export-csv" class="w-full text-left px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-2 font-semibold cursor-pointer">
                <span>CSV</span>
              </button>
              <button id="btn-export-pdf" class="w-full text-left px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-2 font-semibold cursor-pointer">
                <span>PDF</span>
              </button>
              <div class="border-t border-slate-100 dark:border-slate-700 my-1"></div>
              <button id="btn-open-audit" class="w-full text-left px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-2 font-semibold cursor-pointer">
                <span>History</span>
              </button>
              <button id="btn-email-faculty" class="w-full text-left px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center gap-2 font-semibold cursor-pointer border-t border-slate-100 dark:border-slate-700 pt-2 mt-1">
                <span>Email to faculty</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>


    {fetchError ? (
      <div class="error-banner">
        <h3>Database error</h3>
        <p>Could not load the timetable. Ensure your database tables are created and contain data.</p>
        <code class="error-code">{fetchError}</code>
      </div>
    ) : (
      <>
        {/* Surfaced scheduling conflicts alert */}
        {conflictsCount > 0 && (
          <div class="glass-panel p-5 border-l-4 border-red-500 text-slate-800 dark:text-zinc-200 mb-8 flex flex-col gap-3">
            <div class="flex items-center gap-2 text-red-600 dark:text-red-400 font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              <h3 class="text-base font-bold">Scheduling conflicts detected</h3>
            </div>
            <p class="text-sm">The solver could not schedule the following classes due to constraint overlaps. Please adjust settings or room availability in the setup portal and regenerate.</p>
            <ul class="list-disc pl-5 text-sm space-y-1 text-red-750 dark:text-red-300">
              {conflictsDetails.map(c => (
                <li>
                  <strong>{c.subject}</strong> taught by {c.professor} for <strong>{c.batch}</strong>: {c.unscheduledCount} {c.unscheduledCount === 1 ? 'lecture' : 'lectures'} could not be placed.
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Responsive Metric Cards Container: Clean white/slate background with left accent stripes -->
        <section class={`grid grid-cols-1 ${conflictsCount > 0 ? 'md:grid-cols-4' : 'md:grid-cols-3'} gap-[18px]`} style="margin-bottom: 28px;">
          <!-- Card 1 -->
          <div class="glass-panel rounded-[20px] flex flex-col min-h-[144px] transition-all duration-300 hover:-translate-y-1 relative overflow-hidden w-full" style="padding: 24px 26px; box-sizing: border-box;">
            <div class="flex-1 flex flex-col justify-between">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[12px] font-bold text-[#5C6660] dark:text-zinc-400 tracking-wider uppercase block leading-none">Total scheduled slots</span>
                <div class="w-6 h-6 rounded-lg bg-[#6E9B84]/20 flex-shrink-0"></div>
              </div>
              <span class="text-4xl font-semibold text-slate-900 dark:text-white my-2 leading-none">{timetableData.length}</span>
              <div class="text-xs font-medium text-[#5C6660] dark:text-zinc-400">Optimal solution</div>
            </div>
          </div>
          <!-- Card 2 -->
          <div class="glass-panel rounded-[20px] flex flex-col min-h-[144px] transition-all duration-300 hover:-translate-y-1 relative overflow-hidden w-full" style="padding: 24px 26px; box-sizing: border-box;">
            <div class="flex-1 flex flex-col justify-between">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[12px] font-bold text-[#5C6660] dark:text-zinc-400 tracking-wider uppercase block leading-none">Active student batches</span>
                <div class="w-6 h-6 rounded-lg bg-[#D6A24C]/20 flex-shrink-0"></div>
              </div>
              <span class="text-4xl font-semibold text-slate-900 dark:text-white my-2 leading-none">{filterBatches.length}</span>
              <div class="text-xs font-medium text-[#5C6660] dark:text-zinc-400">BCA and MCA cohorts</div>
            </div>
          </div>
          <!-- Card 3 -->
          <div class="glass-panel rounded-[20px] flex flex-col min-h-[144px] transition-all duration-300 hover:-translate-y-1 relative overflow-hidden w-full" style="padding: 24px 26px; box-sizing: border-box;">
            <div class="flex-1 flex flex-col justify-between">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[12px] font-bold text-[#5C6660] dark:text-zinc-400 tracking-wider uppercase block leading-none">Assigned faculty members</span>
                <div class="w-6 h-6 rounded-lg bg-[#8E8CC7]/20 flex-shrink-0"></div>
              </div>
              <span class="text-4xl font-semibold text-slate-900 dark:text-white my-2 leading-none">{filterProfessors.length}</span>
              <div class="text-xs font-medium text-[#5C6660] dark:text-zinc-400">Department qualified</div>
            </div>
          </div>
          <!-- Card 4: Only rendered when conflicts are active -->
          {conflictsCount > 0 && (
            <div class="glass-panel rounded-[20px] flex flex-col min-h-[144px] transition-all duration-300 hover:-translate-y-1 relative overflow-hidden w-full border-red-200/50 dark:border-red-900/30" style="padding: 24px 26px; box-sizing: border-box;">
              <div class="flex-1 flex flex-col justify-between">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-[12px] font-bold text-red-500 dark:text-red-400 tracking-wider uppercase block leading-none">Scheduling conflicts</span>
                  <div class="w-6 h-6 rounded-lg bg-red-500/20 flex-shrink-0 animate-pulse"></div>
                </div>
                <span class="text-4xl font-semibold text-red-600 dark:text-red-400 my-2 leading-none">{conflictsCount}</span>
                <div class="text-xs font-medium text-red-500 dark:text-red-450">Unplaced lectures detected</div>
              </div>
            </div>
          )}
        </section>


        <!-- Section: View Mode Tabs Controls (All Schedules Bar) -->
        <div class="glass-panel p-[6px] flex flex-wrap items-center w-full max-w-2xl" style="margin-bottom: 20px;">
          <button class="quick-view-btn active bg-slate-950 text-white dark:bg-white dark:text-slate-950 shadow-sm text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl flex-1 text-center transition-all" data-view="all">
            All schedules
          </button>
          <button class="quick-view-btn text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl flex-1 text-center transition-all text-[#5C6660] hover:text-slate-950 hover:bg-white/40 dark:text-zinc-400 dark:hover:text-slate-100 dark:hover:bg-white/5" data-view="personal">
            My schedule
          </button>
          <button class="quick-view-btn text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl flex-1 text-center transition-all text-[#5C6660] hover:text-slate-950 hover:bg-white/40 dark:text-zinc-400 dark:hover:text-slate-100 dark:hover:bg-white/5" data-view="utilization">
            Room utilization
          </button>
          <button class="quick-view-btn text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl flex-1 text-center transition-all text-[#5C6660] hover:text-slate-950 hover:bg-white/40 dark:text-zinc-400 dark:hover:text-slate-100 dark:hover:bg-white/5" data-view="workload">
            Faculty workload
          </button>
        </div>
        
        <!-- Section: Filter Dropdowns (Student Batch Bar) -->
        <section class="glass-panel p-5" style="margin-bottom: 28px;">
          <!-- Dropdown Fields Grid (Spaced layout to prevent collisions) -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- 1. Searchable Batch Combobox -->
            <div class="combobox-wrapper filter-group relative w-full" id="combo-batch">
              <label class="block text-xs font-bold text-[#5C6660] dark:text-zinc-400 tracking-wider uppercase mb-1.5">Student batch</label>
              <div class="relative">
                <input 
                  type="text" 
                  placeholder="All batches" 
                  class="combobox-input w-full bg-white/40 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 rounded-xl px-3 py-2.5 text-sm text-slate-900 dark:text-white font-medium focus:ring-2 focus:ring-[#6E9B84] cursor-pointer focus:outline-none transition-all" 
                  readonly
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 dark:text-slate-500">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </span>
              </div>
              <div class="combobox-dropdown absolute left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-lg z-30 hidden animate-fade-in">
                <div class="p-2 border-b border-slate-200 dark:border-slate-700 sticky top-0 bg-white dark:bg-slate-800">
                  <input type="text" placeholder="Search batch..." class="combobox-search w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded px-2.5 py-1.5 text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:border-primary" />
                </div>
                <div class="combobox-options">
                  <div class="combobox-option px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer font-semibold active" data-value="all">All batches</div>
                  {filterBatches.map(b => (
                    <div class="combobox-option px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer" data-value={b}>{b}</div>
                  ))}
                </div>
              </div>
            </div>

            <!-- 2. Searchable Faculty Combobox -->
            <div class="combobox-wrapper filter-group relative w-full" id="combo-prof">
              <label class="block text-xs font-bold text-[#5C6660] dark:text-zinc-400 tracking-wider uppercase mb-1.5">Faculty member</label>
              <div class="relative">
                <input 
                  type="text" 
                  placeholder="All professors" 
                  class="combobox-input w-full bg-white/40 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 rounded-xl px-3 py-2.5 text-sm text-slate-900 dark:text-white font-medium focus:ring-2 focus:ring-[#6E9B84] cursor-pointer focus:outline-none transition-all" 
                  readonly
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 dark:text-slate-500">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
                </span>
              </div>
              <div class="combobox-dropdown absolute left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-lg z-30 hidden animate-fade-in">
                <div class="p-2 border-b border-slate-200 dark:border-slate-700 sticky top-0 bg-white dark:bg-slate-800">
                  <input type="text" placeholder="Search professor..." class="combobox-search w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded px-2.5 py-1.5 text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:border-primary" />
                </div>
                <div class="combobox-options">
                  <div class="combobox-option px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer font-semibold active" data-value="all">All professors</div>
                  {filterProfessors.map(p => (
                    <div class="combobox-option px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer" data-value={p}>{p}</div>
                  ))}
                </div>
              </div>
            </div>

            <!-- 3. Searchable Room Combobox -->
            <div class="combobox-wrapper filter-group relative w-full" id="combo-room">
              <label class="block text-xs font-bold text-[#5C6660] dark:text-zinc-400 tracking-wider uppercase mb-1.5">Room number</label>
              <div class="relative">
                <input 
                  type="text" 
                  placeholder="All rooms" 
                  class="combobox-input w-full bg-white/40 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 rounded-xl px-3 py-2.5 text-sm text-slate-900 dark:text-white font-medium focus:ring-2 focus:ring-[#6E9B84] cursor-pointer focus:outline-none transition-all" 
                  readonly
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 dark:text-slate-500">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </span>
              </div>
              <div class="combobox-dropdown absolute left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-lg z-30 hidden animate-fade-in">
                <div class="p-2 border-b border-slate-200 dark:border-slate-700 sticky top-0 bg-white dark:bg-slate-800">
                  <input type="text" placeholder="Search room..." class="combobox-search w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded px-2.5 py-1.5 text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:border-primary" />
                </div>
                <div class="combobox-options">
                  <div class="combobox-option px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer font-semibold active" data-value="all">All rooms</div>
                  {filterRooms.map(r => (
                    <div class="combobox-option px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer" data-value={r}>{r}</div>
                  ))}
                </div>
              </div>
            </div>
            
            <!-- Reset Button -->
            <div class="flex items-end">
              <button id="btn-reset-filters" class="w-full h-11 text-sm font-semibold text-[#5C6660] hover:text-slate-950 hover:bg-white dark:text-zinc-300 dark:hover:text-white dark:hover:bg-slate-800 border border-slate-200/60 dark:border-slate-700/60 rounded-xl transition-all duration-150 flex items-center justify-center shadow-sm cursor-pointer glass-panel">
                Reset filters
              </button>
            </div>
          </div>
        </section>

        <!-- View Toggle Control Segment (Breathing space between filters and main calendar grid) -->
        <!-- 1. Calendar Grid View Container (Nests desktop table strictly under hidden lg:block) -->
        <section id="calendar-grid-view" class="view-panel active">
          <!-- Dedicated View Control Toolbar above the table -->
          <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
            <div class="text-xs font-bold text-[#5C6660] dark:text-zinc-400 uppercase tracking-widest flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
