<script>
  document.addEventListener('DOMContentLoaded', () => {
    // -----------------------------------------------------------------
    // 1. TABS SYSTEM & MAIN VIEWS
    // -----------------------------------------------------------------
    const btnViewGridCorner = document.getElementById('btn-view-grid-corner');
    const btnViewTableCorner = document.getElementById('btn-view-table-corner');
    const btnViewGridTable = document.getElementById('btn-view-grid-table');
    const btnViewTableTable = document.getElementById('btn-view-table-table');

    const gridView = document.getElementById('calendar-grid-view');
    const tableView = document.getElementById('detailed-table-view');
    const mobileView = document.getElementById('mobile-agenda-view');
    const roomUtilView = document.getElementById('room-utilization-panel');
    const facultyWorkloadView = document.getElementById('faculty-workload-panel');

    const viewPanels = [gridView, tableView, roomUtilView, facultyWorkloadView];
    const gridToggleBtns = [btnViewGridCorner, btnViewGridTable];
    const tableToggleBtns = [btnViewTableCorner, btnViewTableTable];

    function showOnlyPanel(panelToShow) {
      viewPanels.forEach(p => {
        if (p) p.classList.remove('active');
      });
      if (panelToShow) {
        panelToShow.classList.add('active');
      }
      
      // Handle mobile visibility overrides
      if (panelToShow === gridView) {
        if (mobileView) mobileView.classList.add('active');
      } else {
        if (mobileView) mobileView.classList.remove('active');
      }
    }

    gridToggleBtns.forEach(btn => {
      btn?.addEventListener('click', () => {
        gridToggleBtns.forEach(b => b?.classList.add('active'));
        tableToggleBtns.forEach(b => b?.classList.remove('active'));
        resetQuickViewButtons();
        showOnlyPanel(gridView);
      });
    });

    tableToggleBtns.forEach(btn => {
      btn?.addEventListener('click', () => {
        tableToggleBtns.forEach(b => b?.classList.add('active'));
        gridToggleBtns.forEach(b => b?.classList.remove('active'));
        resetQuickViewButtons();
        showOnlyPanel(tableView);
      });
    });

    // -----------------------------------------------------------------
    // 2. QUICK VIEWS FILTER BUTTONS (Segmented Controls)
    // -----------------------------------------------------------------
    const quickViewBtns = document.querySelectorAll('.quick-view-btn');

    function resetQuickViewButtons() {
      quickViewBtns.forEach(b => {
        b.classList.remove('active', 'bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'shadow', 'border', 'border-slate-200/80', 'dark:border-slate-700');
        b.classList.add('text-slate-600', 'hover:text-slate-900', 'dark:text-slate-400', 'dark:hover:text-slate-100');
      });
    }

    quickViewBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        resetQuickViewButtons();
        btn.classList.add('active', 'bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'shadow', 'border', 'border-slate-200/80', 'dark:border-slate-700');
        btn.classList.remove('text-slate-600', 'hover:text-slate-900', 'dark:text-slate-400', 'dark:hover:text-slate-100');

        // Reset Table/Grid top headers state if we jump to analysis
        gridToggleBtns.forEach(b => b?.classList.remove('active'));
        tableToggleBtns.forEach(b => b?.classList.remove('active'));

        const mode = btn.getAttribute('data-view');
        if (mode === 'all') {
          gridToggleBtns.forEach(b => b?.classList.add('active'));
          showOnlyPanel(gridView);
          resetCustomFilters();
        } else if (mode === 'personal') {
          gridToggleBtns.forEach(b => b?.classList.add('active'));
          showOnlyPanel(gridView);
          filterToMySchedule();
        } else if (mode === 'utilization') {
          showOnlyPanel(roomUtilView);
        } else if (mode === 'workload') {
          showOnlyPanel(facultyWorkloadView);
        }
      });
    });

    // Filter to First Professor's schedule for "My Schedule" demo view
    function filterToMySchedule() {
      const profOptions = document.querySelectorAll('#combo-prof .combobox-option');
      if (profOptions.length > 1) {
        const firstProf = profOptions[1].getAttribute('data-value');
        updateComboboxValue('combo-prof', firstProf);
      }
    }

    function resetCustomFilters() {
      updateComboboxValue('combo-batch', 'all');
      updateComboboxValue('combo-prof', 'all');
      updateComboboxValue('combo-room', 'all');
      applyFilters();
    }

    // -----------------------------------------------------------------
    // 3. TOAST SYSTEM
    // -----------------------------------------------------------------
    const toast = document.getElementById('toast-notif');
    function showToast(message, isError = false) {
      if (!toast) return;
      toast.textContent = message;
      toast.className = `toast ${isError ? 'error' : 'success'}`;
      toast.style.display = 'block';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 4000);
    }

    // -----------------------------------------------------------------
    // 4. DRAWERS (AUDIT TRAIL & METRICS)
    // -----------------------------------------------------------------
    const overlay = document.getElementById('drawer-overlay');
    const auditDrawer = document.getElementById('audit-drawer');
    const btnOpenAudit = document.getElementById('btn-open-audit');
    const auditCloseBtn = document.getElementById('audit-close-btn');
    const btnClearAudit = document.getElementById('btn-clear-audit');

    const metricsDrawer = document.getElementById('metrics-drawer');
    const btnOpenMetrics = document.getElementById('btn-open-metrics');
    const metricsCloseBtn = document.getElementById('metrics-close-btn');

    function toggleDrawer(drawer, show) {
      if (show) {
        drawer?.classList.remove('translate-x-full');
        overlay?.classList.remove('hidden');
      } else {
        drawer?.classList.add('translate-x-full');
        if (auditDrawer?.classList.contains('translate-x-full') && metricsDrawer?.classList.contains('translate-x-full')) {
          overlay?.classList.add('hidden');
        }
      }
    }

    btnOpenAudit?.addEventListener('click', () => {
      updateAuditTrailUI();
      toggleDrawer(auditDrawer, true);
    });
    auditCloseBtn?.addEventListener('click', () => toggleDrawer(auditDrawer, false));

    btnOpenMetrics?.addEventListener('click', () => toggleDrawer(metricsDrawer, true));
    metricsCloseBtn?.addEventListener('click', () => toggleDrawer(metricsDrawer, false));
    overlay?.addEventListener('click', () => {
      toggleDrawer(auditDrawer, false);
      toggleDrawer(metricsDrawer, false);
    });

    // -----------------------------------------------------------------
    // LocalStorage Audit Logger
    // -----------------------------------------------------------------
    function logAuditTrail(action, detail) {
      const logs = JSON.parse(localStorage.getItem('scheduler_audit_trail') || '[]');
      const timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      logs.unshift({ action, detail, timestamp });
      if (logs.length > 20) logs.pop();
      localStorage.setItem('scheduler_audit_trail', JSON.stringify(logs));
      updateAuditTrailUI();
    }

    function updateAuditTrailUI() {
      const list = document.getElementById('audit-trail-list');
      if (!list) return;
      const logs = JSON.parse(localStorage.getItem('scheduler_audit_trail') || '[]');
      if (logs.length === 0) {
        list.innerHTML = `<div class="text-xs text-muted italic text-center py-8">No modifications logged yet.</div>`;
        return;
      }
      list.innerHTML = logs.map(log => `
        <div class="border-b border-slate-200 dark:border-slate-800 py-2.5 text-xs">
          <div class="flex justify-between items-center mb-1">
            <span class="font-bold text-indigo-600">${log.action}</span>
            <span class="text-slate-500 text-[10px]">${log.timestamp}</span>
          </div>
          <p class="text-slate-800 dark:text-zinc-200 leading-relaxed">${log.detail}</p>
        </div>
      `).join('');
    }

    btnClearAudit?.addEventListener('click', () => {
      localStorage.removeItem('scheduler_audit_trail');
      updateAuditTrailUI();
      showToast('Audit trail history logs cleared!');
    });

    // -----------------------------------------------------------------
    // 5. SEARCHABLE COMBOBOX CONTROLS
    // -----------------------------------------------------------------
    const comboboxes = document.querySelectorAll('.combobox-wrapper');
    
    comboboxes.forEach(combo => {
      const input = combo.querySelector('.combobox-input') as HTMLInputElement;
      const dropdown = combo.querySelector('.combobox-dropdown');
      const search = combo.querySelector('.combobox-search') as HTMLInputElement;
      const options = combo.querySelectorAll('.combobox-option');

      input?.addEventListener('click', (e) => {
        e.stopPropagation();
        document.querySelectorAll('.combobox-dropdown').forEach(d => {
          if (d !== dropdown) d.classList.add('hidden');
        });
        dropdown?.classList.toggle('hidden');
        if (!dropdown?.classList.contains('hidden')) {
          search?.focus();
        }
      });

      search?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        options.forEach(opt => {
          const text = opt.textContent?.toLowerCase() || '';
          if (text.includes(query)) {
            (opt as HTMLElement).style.display = 'block';
          } else {
            (opt as HTMLElement).style.display = 'none';
          }
        });
      });

      options.forEach(opt => {
        opt.addEventListener('click', () => {
          options.forEach(o => o.classList.remove('active', 'font-semibold'));
          opt.classList.add('active', 'font-semibold');
          
          const val = opt.getAttribute('data-value') || 'all';
          const text = opt.textContent || '';
          
          input.value = val === 'all' ? '' : text;
          input.placeholder = text;
          input.setAttribute('data-selected-value', val);
          
          dropdown?.classList.add('hidden');
          search.value = '';
          options.forEach(o => ((o as HTMLElement).style.display = 'block'));
          
          applyFilters();
        });
      });
    });

    document.addEventListener('click', () => {
      document.querySelectorAll('.combobox-dropdown').forEach(d => d.classList.add('hidden'));
    });

    function updateComboboxValue(comboId, value) {
      const combo = document.getElementById(comboId);
      if (!combo) return;
      const input = combo.querySelector('.combobox-input') as HTMLInputElement;
      const option = combo.querySelector(`.combobox-option[data-value="${value}"]`);
      if (input && option) {
        input.value = value === 'all' ? '' : (option.textContent || '');
        input.placeholder = option.textContent || 'All';
        input.setAttribute('data-selected-value', value);
        combo.querySelectorAll('.combobox-option').forEach(o => o.classList.remove('active', 'font-semibold'));
        option.classList.add('active', 'font-semibold');
      }
    }

    function getSelectedComboVal(comboId) {
      const input = document.querySelector(`#${comboId} .combobox-input`);
      return input?.getAttribute('data-selected-value') || 'all';
    }

    function applyFilters() {
      const batchVal = getSelectedComboVal('combo-batch');
      const profVal = getSelectedComboVal('combo-prof');
      const roomVal = getSelectedComboVal('combo-room');

      const cards = document.querySelectorAll('.schedule-card');
      cards.forEach(card => {
        const cardBatch = card.getAttribute('data-batch');
        const cardProf = card.getAttribute('data-prof');
        const cardRoom = card.getAttribute('data-room');

        const matchBatch = batchVal === 'all' || cardBatch === batchVal;
        const matchProf = profVal === 'all' || cardProf === profVal;
        const matchRoom = roomVal === 'all' || cardRoom === roomVal;

        if (matchBatch && matchProf && matchRoom) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      const rows = document.querySelectorAll('.schedule-row');
      rows.forEach(row => {
        const rowBatch = row.getAttribute('data-batch');
        const rowProf = row.getAttribute('data-prof');
        const rowRoom = row.getAttribute('data-room');

        const matchBatch = batchVal === 'all' || rowBatch === batchVal;
        const matchProf = profVal === 'all' || rowProf === profVal;
        const matchRoom = roomVal === 'all' || rowRoom === roomVal;

        if (matchBatch && matchProf && matchRoom) {
          (row as HTMLElement).style.display = 'table-row';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    }

    const btnReset = document.getElementById('btn-reset-filters');
    btnReset?.addEventListener('click', resetCustomFilters);

    // -----------------------------------------------------------------
    // 6. DYNAMIC DETAIL MODAL & EDIT ACTIONS
    // -----------------------------------------------------------------
    const modal = document.getElementById('detail-modal');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalCancelBtn = document.getElementById('modal-cancel-btn');
    const modalDeleteBtn = document.getElementById('modal-delete-btn');
    const modalEditBtn = document.getElementById('modal-edit-btn');
    const modalEditForm = document.getElementById('modal-edit-form');

    function openDetailModal(card) {
      if (!modal) return;
      
      const sId = card.getAttribute('data-id');
      const subject = card.getAttribute('data-subject');
      const batch = card.getAttribute('data-batch');
      const batchCount = card.getAttribute('data-batch-count');
      const room = card.getAttribute('data-room');
      const roomCap = card.getAttribute('data-room-capacity');
      const prof = card.getAttribute('data-prof');
      const profEmail = card.getAttribute('data-prof-email');
      const profDept = card.getAttribute('data-prof-department') || card.getAttribute('data-prof-dept');
      const day = card.getAttribute('data-day');
      const slot = card.getAttribute('data-slot');

      (modal.querySelector('#modal-subject') as HTMLElement).textContent = subject;
      (modal.querySelector('#modal-batch-badge') as HTMLElement).textContent = batch;
      (modal.querySelector('#modal-batch-badge') as HTMLElement).className = `inline-block px-2 py-0.5 rounded text-[10px] font-bold mb-1 ${getBatchBadgeColor(batch)}`;
      (modal.querySelector('#modal-batch-count') as HTMLElement).textContent = batchCount;
      (modal.querySelector('#modal-room-badge') as HTMLElement).textContent = room;
      (modal.querySelector('#modal-room-cap') as HTMLElement).textContent = roomCap;
      (modal.querySelector('#modal-prof-name') as HTMLElement).textContent = prof;
      (modal.querySelector('#modal-prof-dept') as HTMLElement).textContent = profDept;
      (modal.querySelector('#modal-prof-email') as HTMLElement).textContent = profEmail;
      (modal.querySelector('#modal-prof-avatar') as HTMLElement).textContent = prof.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();

      const sCount = parseInt(batchCount || '0');
      const rCap = parseInt(roomCap || '0');
      const statusText = modal.querySelector('#modal-cap-status') as HTMLElement;
      if (rCap >= sCount) {
        statusText.textContent = `🟢 Capacity OK (${rCap - sCount} spare seats)`;
        statusText.className = "text-[9px] mt-1 font-semibold text-emerald-600 dark:text-emerald-450";
      } else {
        statusText.textContent = `🔴 OVER CAPACITY by ${sCount - rCap} seats!`;
        statusText.className = "text-[9px] mt-1 font-semibold text-red-500";
      }

      modal.setAttribute('data-active-id', sId);
      modal.setAttribute('data-subject', subject);
      modal.setAttribute('data-batch', batch);
      modal.setAttribute('data-day', day);
      modal.setAttribute('data-slot', slot);
      modal.setAttribute('data-prof', prof);
      modal.setAttribute('data-room', room);

      const editDay = document.getElementById('modal-edit-day') as HTMLSelectElement;
      const editSlot = document.getElementById('modal-edit-slot') as HTMLSelectElement;
      if (editDay) editDay.value = day;
      if (editSlot) editSlot.value = slot;

      matchDropdownsByName(prof, room);

      modalEditForm?.classList.add('hidden');
      if (modalEditBtn) modalEditBtn.textContent = "Edit / Reassign";

      modal.classList.remove('hidden');
    }

    function getBatchBadgeColor(batchName) {
      const name = (batchName || '').toLowerCase();
      if (name.includes('1st') || name.includes('1')) {
        return 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/40 dark:text-indigo-200';
      }
      if (name.includes('2nd') || name.includes('2')) {
        return 'bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-200';
      }
      return 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200';
    }

    function matchDropdownsByName(profName, roomNum) {
      const profSelect = document.getElementById('modal-edit-prof') as HTMLSelectElement;
      const roomSelect = document.getElementById('modal-edit-room') as HTMLSelectElement;
      
      if (profSelect) {
        Array.from(profSelect.options).forEach(opt => {
          if (opt.textContent?.trim() === profName.trim()) {
            profSelect.value = opt.value;
          }
        });
      }
      if (roomSelect) {
        Array.from(roomSelect.options).forEach(opt => {
          if (opt.textContent?.includes(roomNum)) {
            roomSelect.value = opt.value;
          }
        });
      }
    }

    function closeModal() {
      modal?.classList.add('hidden');
    }

    modalCloseBtn?.addEventListener('click', closeModal);
    modalCancelBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    function attachModalEvents() {
      const cards = document.querySelectorAll('.schedule-card');
      cards.forEach(card => {
        card.addEventListener('click', (e) => {
          e.stopPropagation();
          openDetailModal(card);
        });
      });
      
      const tableRows = document.querySelectorAll('.schedule-row');
      tableRows.forEach(row => {
        row.addEventListener('click', () => {
          openDetailModal(row);
        });
      });
    }

    attachModalEvents();

    modalEditBtn?.addEventListener('click', () => {
      if (modalEditForm?.classList.contains('hidden')) {
        modalEditForm.classList.remove('hidden');
        modalEditBtn.textContent = "Cancel Edit";
      } else {
        modalEditForm?.classList.add('hidden');
        modalEditBtn.textContent = "Edit / Reassign";
      }
    });

    modalEditForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const sId = modal?.getAttribute('data-id') || modal?.getAttribute('data-active-id');
      const subject = modal?.getAttribute('data-subject');
      const batch = modal?.getAttribute('data-batch');

      if (!sId) return;

      const formData = new FormData(modalEditForm as HTMLFormElement);
      const targetDay = formData.get('day_of_week');
      const targetSlot = formData.get('time_slot');
      const targetRoomId = formData.get('room_id');
      const targetProfId = formData.get('professor_id');

      const otherCards = document.querySelectorAll(`.schedule-card:not([data-id="${sId}"])`);
      const targetProfName = (document.getElementById('modal-edit-prof') as HTMLSelectElement).selectedOptions[0]?.textContent || '';
      const targetRoomName = (document.getElementById('modal-edit-room') as HTMLSelectElement).selectedOptions[0]?.textContent?.split('(')[0].trim() || '';

      let conflicts = [];
      otherCards.forEach(c => {
        if (c.getAttribute('data-day') === targetDay && c.getAttribute('data-slot') === targetSlot) {
          if (c.getAttribute('data-prof') === targetProfName) {
            conflicts.push(`Faculty member ${targetProfName} is booked elsewhere at this time.`);
          }
          if (c.getAttribute('data-batch') === batch) {
            conflicts.push(`Student Batch ${batch} has another class scheduled in this slot.`);
          }
          if (c.getAttribute('data-room') === targetRoomName) {
            conflicts.push(`Classroom ${targetRoomName} is occupied by another lesson.`);
          }
        }
      });

      if (conflicts.length > 0) {
        if (!confirm(`⚠️ Hard Constraint Conflict Detected:\n\n` + conflicts.join('\n') + `\n\nForce manual override?`)) {
          return;
        }
      }

      try {
        const res = await fetch('/api/timetable', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: sId,
            day_of_week: targetDay,
            time_slot: targetSlot,
            room_id: targetRoomId,
            professor_id: targetProfId
          })
        });
        const result = await res.json();
        if (result.success) {
          showToast('Timetable entry updated successfully!');
          logAuditTrail('Edited Slot', `Modified details for "${subject}" (${batch}) at ${targetDay} ${targetSlot}`);
          closeModal();
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(result.error || 'Failed to reassign slot', true);
        }
      } catch (err) {
        showToast('Network error updating timetable slot', true);
      }
    });

    modalDeleteBtn?.addEventListener('click', async () => {
      const sId = modal?.getAttribute('data-active-id');
      const subject = modal?.getAttribute('data-subject');
      const batch = modal?.getAttribute('data-batch');
      const day = modal?.getAttribute('data-day');
      const slot = modal?.getAttribute('data-slot');

      if (!sId) return;

      if (!confirm(`Are you sure you want to delete "${subject}" for ${batch} scheduled on ${day} at ${slot}?`)) {
        return;
      }

      try {
        const res = await fetch(`/api/timetable?id=${sId}`, {
          method: 'DELETE'
        });
        const result = await res.json();
        if (result.success) {
          showToast('Timetable entry deleted successfully!');
          logAuditTrail('Deleted Slot', `Removed "${subject}" (${batch}) from ${day} ${slot}`);
          closeModal();
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(result.error || 'Failed to delete slot.', true);
        }
      } catch (e) {
        showToast('Network error deleting slot.', true);
      }
    });

    // -----------------------------------------------------------------
    // 7. DRAG AND DROP FUNCTIONALITY (GRID ONLY)
    // -----------------------------------------------------------------
    const draggableCards = document.querySelectorAll('.schedule-card');
    const dropZones = document.querySelectorAll('.calendar-cell');

    draggableCards.forEach(card => {
      card.addEventListener('dragstart', (e: any) => {
        e.dataTransfer.setData('text/plain', card.getAttribute('data-id'));
        card.classList.add('opacity-50');
      });
      
      card.addEventListener('dragend', () => {
        card.classList.remove('opacity-50');
      });
    });

    dropZones.forEach(zone => {
      if (zone.classList.contains('break-cell')) return;

      zone.addEventListener('dragover', (e) => {
        e.preventDefault();
        zone.classList.add('bg-primary/5', 'border-primary/50');
      });

      zone.addEventListener('dragleave', () => {
        zone.classList.remove('bg-primary/5', 'border-primary/50');
      });

      zone.addEventListener('drop', async (e: any) => {
        e.preventDefault();
        zone.classList.remove('bg-primary/5', 'border-primary/50');

        const droppedId = e.dataTransfer.getData('text/plain');
        const targetDay = zone.getAttribute('data-day');
        const targetSlot = zone.getAttribute('data-slot');

        if (!droppedId || !targetDay || !targetSlot) return;

        const card = document.querySelector(`.schedule-card[data-id="${droppedId}"]`);
        if (!card) return;

        const subject = card.getAttribute('data-subject');
        const batch = card.getAttribute('data-batch');
        const prof = card.getAttribute('data-prof');
        const room = card.getAttribute('data-room');
        const oldDay = card.getAttribute('data-day');
        const oldSlot = card.getAttribute('data-slot');

        if (oldDay === targetDay && oldSlot === targetSlot) return;

        const otherCards = document.querySelectorAll(`.schedule-card:not([data-id="${droppedId}"])`);
        let conflicts = [];

        otherCards.forEach(c => {
          if (c.getAttribute('data-day') === targetDay && c.getAttribute('data-slot') === targetSlot) {
            if (c.getAttribute('data-prof') === prof) {
              conflicts.push(`Faculty member ${prof} is already booked elsewhere in this slot.`);
            }
            if (c.getAttribute('data-batch') === batch) {
              conflicts.push(`Student Batch ${batch} has another class scheduled in this slot.`);
            }
            if (c.getAttribute('data-room') === room) {
              conflicts.push(`Classroom ${room} is occupied by another lesson.`);
            }
          }
        });

        if (conflicts.length > 0) {
          if (!confirm(`⚠️ Hard Constraint Conflict Detected:\n\n` + conflicts.join('\n') + `\n\nForce manual override?`)) {
            return;
          }
        }

        try {
          const res = await fetch('/api/timetable', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id: droppedId,
              day_of_week: targetDay,
              time_slot: targetSlot
            })
          });
          const result = await res.json();
          if (result.success) {
            showToast('Slot moved successfully!');
            logAuditTrail('Moved Slot', `Moved "${subject}" (${batch}) from ${oldDay} ${oldSlot} to ${targetDay} ${targetSlot}`);
            setTimeout(() => window.location.reload(), 1000);
          } else {
            showToast(result.error || 'Failed to move slot.', true);
          }
        } catch (err) {
          showToast('Network error moving slot.', true);
        }
      });
    });

    // -----------------------------------------------------------------
    // 8. MOBILE VIEW DAY TAB SWITCHING
    // -----------------------------------------------------------------
    const mobileTabBtns = document.querySelectorAll('.mobile-day-tab-btn');
    const mobileAgendaPanels = document.querySelectorAll('.mobile-agenda-day-panel');

    mobileTabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        mobileTabBtns.forEach(b => {
          b.classList.remove('bg-indigo-600', 'text-white', 'shadow');
          b.classList.add('text-slate-600', 'dark:text-zinc-400', 'hover:text-slate-900', 'dark:hover:text-zinc-200');
        });

        btn.classList.add('bg-indigo-600', 'text-white', 'shadow');
        btn.classList.remove('text-slate-600', 'dark:text-zinc-400', 'hover:text-slate-900', 'dark:hover:text-zinc-200');

        const activeDay = btn.getAttribute('data-mobile-day');
        mobileAgendaPanels.forEach(panel => {
          if (panel.id === `mobile-agenda-${activeDay}`) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });

    // -----------------------------------------------------------------
    // 9. EXPORTS SYSTEMS (CSV, iCal, PDF)
    // -----------------------------------------------------------------

    // iCal Export
    const btnExportICal = document.getElementById('btn-export-ical');
    btnExportICal?.addEventListener('click', () => {
      const activeCards = Array.from(document.querySelectorAll('.schedule-card')).filter(card => {
        return (card as HTMLElement).style.display !== 'none';
      });

      if (activeCards.length === 0) {
        showToast('No scheduled classes to export!', true);
        return;
      }

      let icsContent = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//SchedulerPro//Academic Schedule//EN',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH'
      ];

      const slotTimes = {
        'Slot 1': { start: '090000', end: '103000' },
        'Slot 2': { start: '104500', end: '121500' },
        'Slot 3': { start: '131500', end: '144500' },
        'Slot 4': { start: '150000', end: '163000' },
        'Slot 5': { start: '164500', end: '181500' }
      };

      const dayMap = {
        'Monday': 'MO', 'Tuesday': 'TU', 'Wednesday': 'WE', 'Thursday': 'TH', 'Friday': 'FR', 'Saturday': 'SA', 'Sunday': 'SU'
      };

      const startDates = {
        'Monday': '20260803',
        'Tuesday': '20260804',
        'Wednesday': '20260805',
        'Thursday': '20260806',
        'Friday': '20260807',
        'Saturday': '20260808',
        'Sunday': '20260809'
      };

      activeCards.forEach(c => {
        const card = c as HTMLElement;
        const subject = card.getAttribute('data-subject');
        const batch = card.getAttribute('data-batch');
        const prof = card.getAttribute('data-prof');
        const room = card.getAttribute('data-room');
        const day = card.getAttribute('data-day') || 'Monday';
        const slot = card.getAttribute('data-slot') || 'Slot 1';

        const time = slotTimes[slot] || { start: '090000', end: '100000' };
        const dayCode = dayMap[day] || 'MO';
        const dateStr = startDates[day] || '20260803';

        icsContent.push('BEGIN:VEVENT');
        icsContent.push(`UID:event-${card.getAttribute('data-id')}@schedulerpro.local`);
        icsContent.push(`DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z'}`);
        icsContent.push(`DTSTART;TZID=Asia/Kolkata:${dateStr}T${time.start}`);
        icsContent.push(`DTEND;TZID=Asia/Kolkata:${dateStr}T${time.end}`);
        icsContent.push(`RRULE:FREQ=WEEKLY;BYDAY=${dayCode}`);
        icsContent.push(`SUMMARY:${subject} (${batch})`);
        icsContent.push(`LOCATION:${room}`);
        icsContent.push(`DESCRIPTION:Professor: ${prof}\\nRoom Capacity: ${card.getAttribute('data-room-capacity')}`);
        icsContent.push('END:VEVENT');
      });

      icsContent.push('END:VCALENDAR');

      const blob = new Blob([icsContent.join('\r\n')], { type: 'text/calendar;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', 'academic_schedule.ics');
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('Dynamic calendar iCal (.ics) file generated!');
    });

    // CSV Export
    const btnExportCsv = document.getElementById('btn-export-csv');
    btnExportCsv?.addEventListener('click', () => {
      const dataEl = document.getElementById('timetable-data-raw');
      if (!dataEl) return;
      
      let data: any[] = [];
      try {
        data = JSON.parse(dataEl.textContent || '[]');
      } catch (e) {
        console.error("Failed to parse raw data for CSV", e);
        return;
      }
      
      let csv = 'Day,Time Slot,Student Batch,Subject,Professor,Room\n';
      data.forEach(item => {
        const day = item.day_of_week || '';
        const slot = item.time_slot || '';
        const batch = item.batches?.batch_name || '';
        const subject = item.subjects?.subject_name || '';
        const professor = item.professors?.full_name || '';
        const room = item.rooms?.room_number || '';
        
        const row = [day, slot, batch, subject, professor, room]
          .map(val => `"${val.replace(/"/g, '""')}"`)
          .join(',');
        csv += row + '\n';
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', 'scheduler_timetable.csv');
      link.style.visibility = 'hidden';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('CSV schedule exported!');
    });

    // PDF Vector Export using html2pdf
    const btnExportPdf = document.getElementById('btn-export-pdf');
    btnExportPdf?.addEventListener('click', () => {
      let element: any = gridView;
      let orientation: 'portrait' | 'landscape' = 'landscape';

      if (tableView && tableView.classList.contains('active')) {
        element = tableView;
        orientation = 'portrait';
      } else if (roomUtilView && roomUtilView.classList.contains('active')) {
        element = roomUtilView;
        orientation = 'portrait';
      } else if (facultyWorkloadView && facultyWorkloadView.classList.contains('active')) {
        element = facultyWorkloadView;
        orientation = 'portrait';
      }

      if (!element) return;

      showToast('Compiling vector PDF document...');

      const opt = {
        margin:       10,
        filename:     'scheduler_timetable.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false },
        jsPDF:        { unit: 'mm', format: 'a4', orientation: orientation }
      };

      // @ts-ignore
      html2pdf().set(opt).from(element).save().then(() => {
        showToast('Vector PDF exported successfully!');
      }).catch(err => {
        console.error("PDF generation failed: ", err);
        window.print();
      });
    });

    // -----------------------------------------------------------------
    // 10. RE-RUN AI SOLVER ACTION
    // -----------------------------------------------------------------
    const btnSolver = document.getElementById('btn-dashboard-run-solver');
    btnSolver?.addEventListener('click', async () => {
      btnSolver.setAttribute('disabled', 'true');
      const solverText = btnSolver.querySelector('span');
      const solverSpinner = btnSolver.querySelector('.solver-spinner');
      if (solverText) solverText.textContent = 'Solver running...';
      solverSpinner?.classList.remove('hidden');

      try {
        const res = await fetch('/api/generate', { method: 'POST' });
        const result = await res.json();
        if (result.success) {
          showToast('Timetable schedule generated successfully!');
          logAuditTrail('Optimized Schedule', 'Re-ran constraint satisfaction solver engine successfully');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          showToast(result.error || 'Failed to generate schedule', true);
        }
      } catch (e) {
        showToast('Unexpected network error running solver', true);
      } finally {
        btnSolver.removeAttribute('disabled');
        if (solverText) solverText.textContent = 'Re-run AI Solver';
        solverSpinner?.classList.add('hidden');
      }
    });

    // Actions & Export Dropdown Toggle
    const btnActionsToggle = document.getElementById('btn-actions-toggle');
    const actionsDropdownMenu = document.getElementById('actions-dropdown-menu');

    if (btnActionsToggle && actionsDropdownMenu) {
      btnActionsToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        actionsDropdownMenu.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!actionsDropdownMenu.classList.contains('hidden') && !actionsDropdownMenu.contains(e.target as Node)) {
          actionsDropdownMenu.classList.add('hidden');
        }
      });
    }

    updateAuditTrailUI();
  });
</script>

<style is:global>
  /* Standard system typography & spacious, modern SaaS aesthetics */
  .mesh-glow {
    position: absolute;
