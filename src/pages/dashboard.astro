    margin-bottom: 8px;
    display: inline-block;
  }

  h1 {
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 8px 0;
    color: var(--color-text-primary);
  }

  .description {
    font-size: 16px;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 600px;
    line-height: 1.5;
  }

  /* View Toggle Buttons & Header Actions */
  .header-actions {
    display: flex;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-border);
    padding: 4px;
    border-radius: 8px;
    gap: 4px;
    align-items: center;
  }

  .view-toggle-btn {
    background: transparent;
    border: none;
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .view-toggle-btn:hover {
    color: var(--color-text-primary);
  }

  .view-toggle-btn.active {
    background-color: var(--color-border);
    color: var(--color-text-primary);
  }

  /* Admin Portal Link Button */
  .admin-portal-link-btn {
    text-decoration: none;
    background-color: transparent;
    border: none;
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .admin-portal-link-btn:hover {
    color: var(--color-text-primary);
    background-color: var(--color-border);
  }

  /* Actions Divider */
  .actions-divider {
    width: 1px;
    height: 18px;
    background-color: var(--color-border);
    margin: 0 4px;
  }

  /* Export Buttons */
  .export-btn {
    background-color: transparent;
    border: none;
