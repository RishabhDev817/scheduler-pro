---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "University Scheduling System" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Premium Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Blocking Script to Apply Dark Mode Immediately and Prevent Flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body>
    <!-- Top Nav Header -->
    <header class="global-header glass-panel">
      <div class="header-container">
        <a href="/" class="brand-logo">
          <svg class="logo-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
          </svg>
          <span class="logo-text">SchedulerPro</span>
        </a>
        
        <nav class="nav-links">
          <a href="/dashboard" class="nav-item">Dashboard</a>
          <a href="/about" class="nav-item">About</a>
          <a href="/contact" class="nav-item">Contact</a>
          <a href="/privacy" class="nav-item">Privacy</a>
          <a href="/terms" class="nav-item">Terms</a>
        </nav>
        
        <div class="header-actions">
          <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle Theme">
            <!-- Sun Icon (visible in dark mode) -->
            <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon Icon (visible in light mode) -->
            <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="global-main">
      <slot />
    </main>

    <!-- Footer Area -->
    <footer class="global-footer glass-panel">
      <div class="footer-container">
        <div class="footer-brand">
          <span class="footer-logo">SchedulerPro</span>
          <p class="copyright">© 2026 University timetable scheduler. All rights reserved.</p>
        </div>
        
        <div class="footer-nav">
          <span class="nav-label">Navigation</span>
          <a href="/dashboard" class="footer-link">Dashboard</a>
          <a href="/about" class="footer-link">About us</a>
          <a href="/contact" class="footer-link">Contact support</a>
          <a href="/privacy" class="footer-link">Privacy policy</a>
          <a href="/terms" class="footer-link">Terms & conditions</a>
        </div>
      </div>
    </footer>

    <!-- Interactive Client Script for Theme Toggling -->
    <script>
      const initThemeToggle = () => {
        const toggleBtn = document.getElementById('theme-toggle');
        if (!toggleBtn) return;

        toggleBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      };

      // Run on page load
      initThemeToggle();
      
      // Re-initialize on View Transitions if applicable later
      document.addEventListener('astro:after-swap', initThemeToggle);
    </script>
  </body>
</html>

<style is:global>
  /* Define Light Theme & General Settings */
  :root {
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-heading: 'Sora', 'Inter', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    
    --color-bg: radial-gradient(at top left, #E7E4F6 0%, transparent 60%),
                radial-gradient(at top right, #E3EDFA 0%, transparent 60%),
                radial-gradient(at bottom center, #FBE9F1 0%, transparent 65%),
                #F6F3FA;
    --color-canvas: rgba(255, 255, 255, 0.6);
    --color-border: rgba(255, 255, 255, 0.95);
    --color-border-hover: rgba(255, 255, 255, 0.5);
    --color-text-primary: #1e293b;
    --color-text-secondary: #475569;
    --color-text-muted: #64748b;
    
    /* Sage green style primary roles */
    --color-primary: #6E9B84;
    --color-primary-dark: #3F5F4F;
    --color-primary-glow: rgba(110, 155, 132, 0.18);
    
    /* Lavender style secondary roles */
    --color-accent-purple: #8E8CC7;
    --color-accent-purple-dark: #4B4880;
    --color-accent-purple-glow: rgba(142, 140, 199, 0.18);
    
    /* Amber style tertiary roles */
    --color-accent-amber: #D6A24C;
    --color-accent-amber-dark: #7A5A1E;
    --color-accent-amber-glow: rgba(214, 162, 76, 0.18);
    
    --glass: rgba(255, 255, 255, 0.6);
    --glass-border: rgba(255, 255, 255, 0.95);
    --glass-blur: 20px;
    
    --header-height: 64px;
    --shadow-sm: 0 4px 16px rgba(60, 70, 65, 0.04);
    --shadow-md: 0 8px 32px rgba(60, 70, 65, 0.08);
    --shadow-lg: 0 16px 48px rgba(60, 70, 65, 0.12);
  }

  /* Define Dark Theme Overrides */
  html.dark {
    --color-bg: radial-gradient(1100px 650px at 8% -5%, #2A2440, transparent),
                radial-gradient(1000px 650px at 100% 0%, #1F2A3D, transparent),
                radial-gradient(1200px 700px at 50% 110%, #331E2B, transparent),
                #14141C;
    --color-canvas: rgba(20, 20, 25, 0.6);
    --color-border: rgba(255, 255, 255, 0.08);
    --color-border-hover: rgba(255, 255, 255, 0.15);
    --color-text-primary: #F0F0F2;
    --color-text-secondary: #B8BCC4;
    --color-text-muted: #8E939E;
    
    /* Sage green style primary roles - Dark Mode Adaptations */
    --color-primary-dark: #A8D4BC;
    --color-primary-glow: rgba(110, 155, 132, 0.22);
    
    /* Lavender style secondary roles - Dark Mode Adaptations */
    --color-accent-purple-dark: #C5C3ED;
    --color-accent-purple-glow: rgba(142, 140, 199, 0.22);
    
    /* Amber style tertiary roles - Dark Mode Adaptations */
    --color-accent-amber-dark: #F3D39B;
    --color-accent-amber-glow: rgba(214, 162, 76, 0.22);
    
    --glass: rgba(255, 255, 255, 0.06);
    --glass-border: rgba(255, 255, 255, 0.12);
    
    --shadow-sm: 0 4px 16px rgba(0, 0, 0, 0.2);
    --shadow-md: 0 8px 32px rgba(0, 0, 0, 0.35);
    --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.5);
  }

  /* Reset & Box Model */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    min-height: 100vh;
    background: var(--color-bg) !important;
    background-attachment: fixed !important;
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    transition: background 0.3s ease, color 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading) !important;
    font-weight: 600 !important;
    letter-spacing: -0.02em !important;
  }

  /* Eye brow / labels style */
  .eyebrow-accent, .nav-label, .label-eyebrow {
    font-size: 12px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.06em !important;
    color: #8B948E !important;
    font-weight: 500 !important;
  }

  /* Layout Structure */
  .global-main {
    flex: 1 0 auto;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  /* Glass Panels General Classes */
  .glass-panel {
    background: var(--glass) !important;
    backdrop-filter: blur(var(--glass-blur, 20px)) !important;
    -webkit-backdrop-filter: blur(var(--glass-blur, 20px)) !important;
    border: 1px solid var(--glass-border) !important;
    border-radius: 20px !important;
    box-shadow: 0 8px 32px rgba(60, 70, 65, 0.08) !important;
  }

  .glass-panel-emphasis {
    background: rgba(255, 255, 255, 0.78) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 20px !important;
    box-shadow: 0 8px 32px rgba(60, 70, 65, 0.08) !important;
  }

  html.dark .glass-panel {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
  }

  html.dark .glass-panel-emphasis {
    background: rgba(255, 255, 255, 0.12) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45) !important;
  }

  /* Header Styling */
  .global-header {
    height: var(--header-height);
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    border-radius: 0 0 20px 20px !important; /* Rounded bottom for top nav header */
    border-top: none !important;
    border-left: none !important;
    border-right: none !important;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .header-container {
    max-width: 1400px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .logo-icon {
    color: var(--color-primary);
  }

  .brand-logo:hover .logo-icon {
    transform: rotate(5deg) scale(1.05);
  }

  .logo-text {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .nav-item {
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-item:hover {
    color: var(--color-text-primary);
  }

  /* Theme Toggle Button Styling */
  .theme-toggle-btn {
    background-color: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    padding: 8px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    width: 36px;
    height: 36px;
  }

  .theme-toggle-btn:hover {
    color: var(--color-text-primary);
    background-color: rgba(255, 255, 255, 0.2);
    border-color: var(--color-border-hover);
  }

  /* Global Focus & Outline resets to override default browser focus styles */
  button:focus,
  a:focus,
  input:focus,
  select:focus,
  textarea:focus {
    outline: none !important;
  }

  button:focus-visible,
  a:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: none !important;
    box-shadow: 0 0 0 3px var(--color-primary-glow) !important;
  }

  /* Prevent browser default red dashed border on invalid form controls */
  :invalid {
    outline: none !important;
    box-shadow: none !important;
  }

  /* Icon visibility based on dark theme */
  .sun-icon {
    display: none;
  }
  
  .moon-icon {
    display: block;
  }

  html.dark .sun-icon {
    display: block;
    color: var(--color-accent-purple);
  }

  html.dark .moon-icon {
    display: none;
  }

  /* Footer Styling */
  .global-footer {
    width: 100%;
    padding: 48px 0;
    flex-shrink: 0;
    border-radius: 20px 20px 0 0 !important; /* Rounded top for footer */
    border-bottom: none !important;
    border-left: none !important;
    border-right: none !important;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 32px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 320px;
  }

  .footer-logo {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .copyright {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-text-primary);
  }

  /* Responsive styling */
  @media (max-width: 768px) {
    .header-container {
      padding: 0 16px;
    }
    
    .nav-links {
      display: none;
    }
    
    .footer-container {
      flex-direction: column;
      gap: 24px;
      padding: 0 16px;
    }
  }
</style>
